<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.ReportsHubController"
    styleClass="reports-root">

    <!-- ── Header — shared shell (DESIGN_SYSTEM.md §5.1), built by AppShell
         and injected by the controller at initialize() so both apps render
         pixel-identical chrome. ─────────────────────────────────────── -->
    <top>
        <StackPane fx:id="headerSlot"/>
    </top>

    <!-- ── Two-panel body ──────────────────────────────────────── -->
    <center>
        <HBox>

            <!-- Left: shared navigation rail (§5.2), built by AppShell and
                 injected by the controller — carries navigation only. -->
            <StackPane fx:id="railSlot"/>

            <Separator orientation="VERTICAL"/>

            <!-- Right content: report rows -->
            <VBox HBox.hgrow="ALWAYS" styleClass="hub-content">

                <!-- Module title + count + report filter. The report-list
                     filter (not global search — DESIGN_SYSTEM.md §7.6) lives
                     here rather than in the rail, which carries navigation
                     only in the shared shell. -->
                <HBox styleClass="hub-content-header" alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="moduleTitle" styleClass="hub-content-title"/>
                    <Label fx:id="reportCount" styleClass="hub-content-sub"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <TextField fx:id="searchField"
                               promptText="Filter reports…"
                               styleClass="hub-search"/>
                    <HBox.margin>
                        <Insets top="20" right="28" bottom="16" left="28"/>
                    </HBox.margin>
                </HBox>

                <!-- Report rows in a scroll pane -->
                <ScrollPane fitToWidth="true"
                            styleClass="hub-scroll"
                            VBox.vgrow="ALWAYS">
                    <VBox fx:id="reportList"
                          styleClass="hub-report-list"
                          spacing="6">
                        <padding>
                            <Insets top="0" right="28" bottom="20" left="28"/>
                        </padding>
                    </VBox>
                </ScrollPane>

            </VBox>

        </HBox>
    </center>

</BorderPane>
