<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ArCustomerAccountStatusController"
    styleClass="sel-root"
    prefWidth="600" prefHeight="440">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Customer Account Status" styleClass="sel-title"/>
            <Label text="Customers by account status with opening balances" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="10" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="10">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <Label text="Customer range" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Customer from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startCustomer" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endCustomer"   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Sub ledger range" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sub ledger from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startSubLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endSubLedger"   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Account status" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="24">
                    <CheckBox fx:id="active"   text="Active"/>
                    <CheckBox fx:id="noSales"  text="No sales"/>
                    <CheckBox fx:id="onHold"   text="On hold"/>
                    <CheckBox fx:id="inactive" text="Inactive"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
