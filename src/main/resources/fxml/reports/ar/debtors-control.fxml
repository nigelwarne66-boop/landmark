<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ArDebtorsControlController"
    styleClass="sel-root"
    prefWidth="620" prefHeight="480">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Debtors Control" styleClass="sel-title"/>
            <Label text="Customer account balances and period sales" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="10" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="10">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <Label text="Range" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sub ledger" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="subLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Customer from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startCustomer" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endCustomer"   HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Sort &amp; period" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sort by" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="sortSeq" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sales basis" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="mtdYtd" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Period ending" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="periodEndDate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Options" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Top N customers" styleClass="sel-label" minWidth="140"/>
                    <TextField fx:id="topN" promptText="0 = all" prefWidth="80"/>
                    <Label text="(0 = show all)" styleClass="sel-sub"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="24">
                    <CheckBox fx:id="includeCreditLimit" text="Include credit limit column"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
