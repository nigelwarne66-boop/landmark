<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.PoDetailController"
    styleClass="sel-root"
    prefWidth="640" prefHeight="620">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Purchase Order Detail" styleClass="sel-title"/>
            <Label text="one row per PO line with quantities and values" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="10" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="10">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <Label text="Selection" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Location" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="locNo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="PO number from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startPoNo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endPoNo" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Supplier from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Order date from / to" styleClass="sel-label" minWidth="140"/>
                    <DatePicker fx:id="startDate" promptText="blank = all dates" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <DatePicker fx:id="endDate" promptText="to" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Status" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="poStatus" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Output" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sort sequence" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="printSeq" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Filter" styleClass="sel-label" minWidth="140"/>
                    <CheckBox fx:id="outstandingOnly" text="Outstanding only"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
