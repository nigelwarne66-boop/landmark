<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.GlProfitLossController"
    styleClass="sel-root"
    prefWidth="620" prefHeight="400">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Profit &amp; Loss" styleClass="sel-title"/>
            <Label text="Income vs expenses for a period range" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="10" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="10">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <Label text="Period range" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="From period" styleClass="sel-label" minWidth="160"/>
                    <ComboBox fx:id="fromPeriod" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="To period" styleClass="sel-label" minWidth="160"/>
                    <ComboBox fx:id="toPeriod" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Account range" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Account from / to" styleClass="sel-label" minWidth="160"/>
                    <ComboBox fx:id="startAcct" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endAcct" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <Label text="Options" styleClass="sel-section"/>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label styleClass="sel-label" minWidth="160"/>
                    <CheckBox fx:id="includeZero" text="Include zero balances"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
