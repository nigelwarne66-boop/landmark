<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ApSupplierAnalysisController"
    styleClass="sel-root"
    prefWidth="580">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Supplier Analysis" styleClass="sel-title"/>
            <Label text="N-month transaction analysis by supplier (Excel only)" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="14" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <VBox styleClass="sel-body" spacing="12">
            <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Supplier from / to" styleClass="sel-label" minWidth="140"/>
                <ComboBox fx:id="startSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="endSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Sub ledger from / to" styleClass="sel-label" minWidth="140"/>
                <ComboBox fx:id="startSubLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="endSubLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Months history" styleClass="sel-label" minWidth="140"/>
                <TextField fx:id="noOfMonths" promptText="1–60" HBox.hgrow="ALWAYS"/>
                <Label text="As at (month end)" styleClass="sel-label" minWidth="120"/>
                <DatePicker fx:id="endDate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Top N suppliers" styleClass="sel-label" minWidth="140"/>
                <TextField fx:id="topNumber" promptText="blank = all" HBox.hgrow="ALWAYS"/>
                <Label text="Based on" styleClass="sel-label" minWidth="120"/>
                <ComboBox fx:id="basedOn" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
        </HBox>
    </bottom>

</BorderPane>
