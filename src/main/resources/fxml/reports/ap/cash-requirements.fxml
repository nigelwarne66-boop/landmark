<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ApCashRequirementsController"
    styleClass="sel-root"
    prefWidth="620">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Cash Requirements" styleClass="sel-title"/>
            <Label text="outstanding transactions due for payment" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="12" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="12">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sub ledger" styleClass="sel-label" minWidth="150"/>
                    <ComboBox fx:id="subLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Supplier from / to" styleClass="sel-label" minWidth="150"/>
                    <ComboBox fx:id="startSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Payment date" styleClass="sel-label" minWidth="150"/>
                    <DatePicker fx:id="paymentDate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Next payment date" styleClass="sel-label" minWidth="120"/>
                    <DatePicker fx:id="nextPaymentDate" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Output" styleClass="sel-label" minWidth="150"/>
                    <ComboBox fx:id="detailSummary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="24">
                    <CheckBox fx:id="onHold" text="Include on-hold"/>
                    <CheckBox fx:id="selected" text="Include selected for payment"/>
                    <CheckBox fx:id="deductWithholding" text="Deduct withholding"/>
                </HBox>

                <Label text="Print transactions where:" styleClass="sel-section"/>
                <CheckBox fx:id="flagMustPay"   text="A) due on/before next payment date and tagged must-pay"/>
                <CheckBox fx:id="flagPromptPay" text="B) marked as prompt pay"/>
                <CheckBox fx:id="flagOverdue"   text="C) due date is before the payment date"/>
                <CheckBox fx:id="flagDue"       text="D) due on/after payment date and before next payment date"/>
                <CheckBox fx:id="flagDiscAvail" text="E) discount available that would be lost after the payment date"/>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
