<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ApAccountReconController"
    styleClass="sel-root"
    prefWidth="580">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Account Reconciliation" styleClass="sel-title"/>
            <Label text="reconciliation detail, invoices matched to payments" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="14" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <VBox styleClass="sel-body" spacing="12">
            <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Supplier from / to" styleClass="sel-label" minWidth="140"/>
                <ComboBox fx:id="startSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="endSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Recon no from / to" styleClass="sel-label" minWidth="140"/>
                <TextField fx:id="startReconNo" promptText="0 = all" HBox.hgrow="ALWAYS"/>
                <TextField fx:id="endReconNo" promptText="to" HBox.hgrow="ALWAYS"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Include" styleClass="sel-label" minWidth="140"/>
                <ComboBox fx:id="unbalancedFlag" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="Currency" styleClass="sel-label" minWidth="140"/>
                <ComboBox fx:id="localFcFlag" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                <ComboBox fx:id="forCurrCode" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
            </HBox>
            <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                <Label text="" styleClass="sel-label" minWidth="140"/>
                <CheckBox fx:id="paymtDocNoInd" text="Show payment instrument details (chq/eft) instead of payment number"/>
            </HBox>

        </VBox>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
