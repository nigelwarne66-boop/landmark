<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.ApFcRevaluationController"
    styleClass="sel-root"
    prefWidth="620">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Foreign Currency Revaluation" styleClass="sel-title"/>
            <Label text="APRC11 — FC transactions with revaluation gain/loss" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="12" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true" styleClass="sel-scroll">
            <VBox styleClass="sel-body" spacing="12">
                <padding><Insets top="8" right="24" bottom="8" left="24"/></padding>

                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Print sequence" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="printSeq" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Supplier from / to" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="startSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <ComboBox fx:id="endSupplier" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Sub ledger" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="subLedger" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Currency" styleClass="sel-label" minWidth="70"/>
                    <ComboBox fx:id="forCurrCode" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="24">
                    <Label text="Document types" styleClass="sel-label" minWidth="140"/>
                    <CheckBox fx:id="invoices" text="Invoices"/>
                    <CheckBox fx:id="drNotes" text="Debit notes"/>
                    <CheckBox fx:id="crNotes" text="Credit notes"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Include" styleClass="sel-label" minWidth="140"/>
                    <ComboBox fx:id="includeRecon" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <Label text="Date basis" styleClass="sel-label" minWidth="80"/>
                    <ComboBox fx:id="docPostInd" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Doc/post date from / to" styleClass="sel-label" minWidth="140"/>
                    <DatePicker fx:id="startDate" promptText="blank = all" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <DatePicker fx:id="endDate" promptText="to" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>
                <HBox styleClass="sel-row" alignment="CENTER_LEFT" spacing="12">
                    <Label text="Reval date from / to" styleClass="sel-label" minWidth="140"/>
                    <DatePicker fx:id="revalStartDate" promptText="blank = all" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                    <DatePicker fx:id="revalEndDate" promptText="to" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="16" right="24" bottom="20" left="24"/></padding>
            <Button text="Cancel" styleClass="sel-btn-cancel" onAction="#onCancel"/>
            <Button text="Excel"  styleClass="sel-btn-excel"  onAction="#onExcel"/>
            <Button text="PDF"    styleClass="sel-btn-pdf"    onAction="#onPdf"/>
        </HBox>
    </bottom>

</BorderPane>
