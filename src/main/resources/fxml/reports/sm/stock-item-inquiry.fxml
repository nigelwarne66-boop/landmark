<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane
    xmlns="http://javafx.com/javafx/21"
    xmlns:fx="http://javafx.com/fxml/1"
    fx:controller="com.landmarksoftware.ui.reports.SmStockItemInquiryController"
    styleClass="sel-root"
    prefWidth="980"
    prefHeight="640">

    <top>
        <VBox styleClass="sel-header">
            <Label text="Stock Item Inquiry" styleClass="sel-title"/>
            <Label text="Item across all locations — quantity and value on hand, with movement drill-down" styleClass="sel-sub"/>
            <VBox.margin><Insets top="20" right="24" bottom="12" left="24"/></VBox.margin>
        </VBox>
    </top>

    <center>
        <VBox>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <padding><Insets top="8" right="16" bottom="6" left="16"/></padding>
                <Label text="Item" styleClass="sel-label" minWidth="50"/>
                <ComboBox fx:id="itemPicker" prefWidth="340"/>
                <Button text="Filter" onAction="#onFilter" styleClass="sel-btn-pdf"/>
            </HBox>
            <HBox fx:id="itemBar" spacing="16" alignment="CENTER_LEFT" styleClass="sel-row">
                <padding><Insets top="4" right="16" bottom="4" left="16"/></padding>
                <Label fx:id="lblItemDesc" styleClass="sel-label"/>
            </HBox>
            <TableView fx:id="locTable" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colLoc"         text="Loc"           prefWidth="60"/>
                    <TableColumn fx:id="colLocName"     text="Description"   prefWidth="320"/>
                    <TableColumn fx:id="colQtyOnHand"   text="Qty On Hand"   prefWidth="130"/>
                    <TableColumn fx:id="colValueOnHand" text="Value On Hand" prefWidth="140"/>
                    <TableColumn fx:id="colStatus"      text="Item Status"   prefWidth="110"/>
                </columns>
                <placeholder><Label text="No locations — select an item and click Filter"/></placeholder>
            </TableView>
            <HBox fx:id="totalsBar" spacing="30" alignment="CENTER_LEFT" styleClass="sel-row">
                <padding><Insets top="6" right="16" bottom="6" left="16"/></padding>
                <Label fx:id="lblTotalQty" style="-fx-font-weight: bold;"/>
                <Label fx:id="lblTotalValue" style="-fx-font-weight: bold;"/>
            </HBox>
        </VBox>
    </center>

    <bottom>
        <HBox styleClass="sel-footer" alignment="CENTER_RIGHT" spacing="10">
            <padding><Insets top="10" right="24" bottom="14" left="24"/></padding>
            <Button text="Transactions"   onAction="#onTransactions" styleClass="sel-btn-excel"/>
            <Button text="Export to Excel" onAction="#onExportExcel"  styleClass="sel-btn-excel"/>
            <Button text="Close"           onAction="#onCancel"       styleClass="sel-btn-cancel"/>
        </HBox>
    </bottom>

</BorderPane>
