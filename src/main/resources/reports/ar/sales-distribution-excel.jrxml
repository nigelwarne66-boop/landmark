<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales-distribution-excel"
              pageWidth="1160" pageHeight="595" orientation="Landscape"
              columnWidth="1160" leftMargin="0" rightMargin="0"
              topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.3" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NO"      class="java.lang.Integer"/>
  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="PERIOD_END"      class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUB_LEDGER_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="THIS_YR"         class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="LAST_YR"         class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="SUM_MTD_THIS"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_MTD_LAST"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YTD_THIS"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YTD_LAST"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"       class="java.lang.Integer" isForPrompting="false"/>

  <field name="subLedger"  class="java.lang.String"/>
  <field name="salesCode"  class="java.lang.String"/>
  <field name="mtdThis"    class="java.math.BigDecimal"/>
  <field name="mtdLast"    class="java.math.BigDecimal"/>
  <field name="mtdVar"     class="java.math.BigDecimal"/>
  <field name="mtdVarPct"  class="java.math.BigDecimal"/>
  <field name="ytdThis"    class="java.math.BigDecimal"/>
  <field name="ytdLast"    class="java.math.BigDecimal"/>
  <field name="ytdVar"     class="java.math.BigDecimal"/>
  <field name="ytdVarPct"  class="java.math.BigDecimal"/>

  <title>
    <band height="40">
      <staticText><reportElement x="0" y="0" width="1160" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Sales Distribution]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1160" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   Period end: " + $P{PERIOD_END} + "   —   Sub ledger: " + $P{SUB_LEDGER_DESC} + "   —   MTD/YTD " + $P{THIS_YR} + " vs " + $P{LAST_YR}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger]]></text></staticText>
      <staticText><reportElement x="102"  y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sales Code]]></text></staticText>
      <staticText><reportElement x="204"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MTD This Year]]></text></staticText>
      <staticText><reportElement x="326"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MTD Last Year]]></text></staticText>
      <staticText><reportElement x="448"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MTD Variance]]></text></staticText>
      <staticText><reportElement x="570"  y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[MTD Var %]]></text></staticText>
      <staticText><reportElement x="672"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[YTD This Year]]></text></staticText>
      <staticText><reportElement x="794"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[YTD Last Year]]></text></staticText>
      <staticText><reportElement x="916"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[YTD Variance]]></text></staticText>
      <staticText><reportElement x="1038" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[YTD Var %]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"    y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField><reportElement x="102"  y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesCode}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="204"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{mtdThis}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="326"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{mtdLast}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="448"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{mtdVar}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement x="570"  y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{mtdVarPct}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="672"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ytdThis}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="794"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ytdLast}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="916"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ytdVar}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement x="1038" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ytdVarPct}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="204" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{ROW_COUNT} + " row(s) — Totals"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="204"  y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_MTD_THIS}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="326"  y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_MTD_LAST}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="672"  y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YTD_THIS}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="794"  y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YTD_LAST}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
