<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transaction-listing-excel"
              pageWidth="2560" pageHeight="595" orientation="Landscape"
              columnWidth="2520" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="PRINT_SEQ_DESC"  class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DATE_BASIS_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="CUST_RANGE"      class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUB_LEDGER_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DATE_RANGE"      class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUMMARY_MODE"    class="java.lang.Boolean" isForPrompting="false"/>
  <parameter name="GRAND_NO"        class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"     class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="custNo"      class="java.lang.String"/>
  <field name="name"        class="java.lang.String"/>
  <field name="subLedger"   class="java.lang.String"/>
  <field name="subLedgerName" class="java.lang.String"/>
  <field name="docDate"     class="java.sql.Date"/>
  <field name="postDate"    class="java.sql.Date"/>
  <field name="dueDate"     class="java.sql.Date"/>
  <field name="docType"     class="java.lang.String"/>
  <field name="docNo"       class="java.lang.String"/>
  <field name="seqNo"       class="java.lang.String"/>
  <field name="amt"         class="java.math.BigDecimal"/>
  <field name="retentAmt"   class="java.math.BigDecimal"/>
  <field name="debit"       class="java.math.BigDecimal"/>
  <field name="credit"      class="java.math.BigDecimal"/>
  <field name="amtPaid"     class="java.math.BigDecimal"/>
  <field name="discTaken"   class="java.math.BigDecimal"/>
  <field name="balance"     class="java.math.BigDecimal"/>
  <field name="fullyPaid"   class="java.lang.String"/>
  <field name="batchNo"     class="java.lang.Integer"/>
  <field name="reconNo"     class="java.lang.Integer"/>
  <field name="auditUser"   class="java.lang.String"/>
  <field name="auditTime"   class="java.lang.String"/>
  <field name="lineNo"      class="java.lang.Integer"/>
  <field name="lineType"    class="java.lang.String"/>
  <field name="glAcctMain"  class="java.lang.Integer"/>
  <field name="glAcctSub"   class="java.lang.Integer"/>
  <field name="qty"         class="java.math.BigDecimal"/>
  <field name="unitCost"    class="java.math.BigDecimal"/>
  <field name="amtExTax"    class="java.math.BigDecimal"/>
  <field name="taxCode"     class="java.lang.String"/>
  <field name="lineTaxAmt"  class="java.math.BigDecimal"/>
  <field name="description" class="java.lang.String"/>
  <field name="reference"   class="java.lang.String"/>

  <variable name="SUM_AMT"     class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{amt}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_DEBIT"   class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{debit}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_CREDIT"  class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{credit}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_BAL"     class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{balance}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="2520" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Transaction Listing]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1400" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{PRINT_SEQ_DESC} + " • " + $P{CUST_RANGE} + " • " + $P{SUB_LEDGER_DESC} + " • " + $P{DATE_BASIS_DESC} + " • " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer No]]></text></staticText>
      <staticText><reportElement x="70"   y="0" width="170" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer Name]]></text></staticText>
      <staticText><reportElement x="240"  y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger]]></text></staticText>
      <staticText><reportElement x="300"  y="0" width="130" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger Name]]></text></staticText>
      <staticText><reportElement x="430"  y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document Date]]></text></staticText>
      <staticText><reportElement x="500"  y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Posting Date]]></text></staticText>
      <staticText><reportElement x="570"  y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Due Date]]></text></staticText>
      <staticText><reportElement x="640"  y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="685"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document No]]></text></staticText>
      <staticText><reportElement x="765"  y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Seq]]></text></staticText>
      <staticText><reportElement x="810"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
      <staticText><reportElement x="890"  y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Retention]]></text></staticText>
      <staticText><reportElement x="960"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Debit]]></text></staticText>
      <staticText><reportElement x="1040" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Credit]]></text></staticText>
      <staticText><reportElement x="1120" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount Paid]]></text></staticText>
      <staticText><reportElement x="1200" y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Discount Taken]]></text></staticText>
      <staticText><reportElement x="1270" y="0" width="85"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Outstanding Balance]]></text></staticText>
      <staticText><reportElement x="1355" y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Fully Paid]]></text></staticText>
      <staticText><reportElement x="1400" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Batch No]]></text></staticText>
      <staticText><reportElement x="1460" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Recon No]]></text></staticText>
      <staticText><reportElement x="1520" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Audit User]]></text></staticText>
      <staticText><reportElement x="1600" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Audit Time]]></text></staticText>
      <staticText><reportElement x="1660" y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line No]]></text></staticText>
      <staticText><reportElement x="1705" y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line Type]]></text></staticText>
      <staticText><reportElement x="1750" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GL Main]]></text></staticText>
      <staticText><reportElement x="1810" y="0" width="55"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GL Sub]]></text></staticText>
      <staticText><reportElement x="1865" y="0" width="65"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Quantity]]></text></staticText>
      <staticText><reportElement x="1930" y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unit Cost]]></text></staticText>
      <staticText><reportElement x="2000" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line Amount Ex Tax]]></text></staticText>
      <staticText><reportElement x="2080" y="0" width="45"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Tax Code]]></text></staticText>
      <staticText><reportElement x="2125" y="0" width="75"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line Tax Amount]]></text></staticText>
      <staticText><reportElement x="2200" y="0" width="160" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line Description]]></text></staticText>
      <staticText><reportElement x="2360" y="0" width="160" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Line Reference]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"    y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{custNo}]]></textFieldExpression></textField>
      <textField><reportElement x="70"   y="0" width="170" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField><reportElement x="240"  y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField><reportElement x="300"  y="0" width="130" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedgerName}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="430" y="0" width="70" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="500" y="0" width="70" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{postDate}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="570" y="0" width="70" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{dueDate}]]></textFieldExpression></textField>
      <textField><reportElement x="640"  y="0" width="45"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField><reportElement x="685"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField><reportElement x="765"  y="0" width="45"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{seqNo}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="810"  y="0" width="80" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="890"  y="0" width="70" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{retentAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="960"  y="0" width="80" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1040" y="0" width="80" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1120" y="0" width="80" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amtPaid}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1200" y="0" width="70" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{discTaken}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1270" y="0" width="85" height="14"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression></textField>
      <textField><reportElement x="1355" y="0" width="45"  height="14"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{fullyPaid}]]></textFieldExpression></textField>
      <textField><reportElement x="1400" y="0" width="60"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{batchNo}]]></textFieldExpression></textField>
      <textField><reportElement x="1460" y="0" width="60"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reconNo}]]></textFieldExpression></textField>
      <textField><reportElement x="1520" y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{auditUser}]]></textFieldExpression></textField>
      <textField><reportElement x="1600" y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{auditTime}]]></textFieldExpression></textField>
      <textField><reportElement x="1660" y="0" width="45"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lineNo}]]></textFieldExpression></textField>
      <textField><reportElement x="1705" y="0" width="45"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lineType}]]></textFieldExpression></textField>
      <textField><reportElement x="1750" y="0" width="60"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glAcctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="1810" y="0" width="55"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glAcctSub}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="1865" y="0" width="65" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="1930" y="0" width="70" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{unitCost}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="2000" y="0" width="80" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amtExTax}]]></textFieldExpression></textField>
      <textField><reportElement x="2080" y="0" width="45"  height="14"/><textElement textAlignment="Center"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{taxCode}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="2125" y="0" width="75" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lineTaxAmt}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="2200" y="0" width="160" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="2360" y="0" width="160" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="500" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{GRAND_NO}==null?0:$P{GRAND_NO}) + " transaction(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="810"  y="3" width="80" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_AMT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="960"  y="3" width="80" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_DEBIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1040" y="3" width="80" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_CREDIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1270" y="3" width="85" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_BAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
