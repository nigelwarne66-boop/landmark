<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transaction-listing"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="PRINT_SEQ_DESC"  class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DATE_BASIS_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="CUST_RANGE"      class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUB_LEDGER_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DATE_RANGE"      class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUMMARY_MODE"    class="java.lang.Boolean" isForPrompting="false"/>
  <parameter name="T_INV_NO"   class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_INV_AMT"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="T_DR_NO"    class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_DR_AMT"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="T_CR_NO"    class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_CR_AMT"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="T_PAY_NO"   class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_PAY_AMT"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="T_VOID_NO"  class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_VOID_AMT" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="T_BAL_NO"   class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="T_BAL_AMT"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_NO"    class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="GRAND_TOTAL" class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="rowType"     class="java.lang.String"/>
  <field name="custNo"      class="java.lang.String"/>
  <field name="name"        class="java.lang.String"/>
  <field name="subLedger"   class="java.lang.String"/>
  <field name="subLedgerName" class="java.lang.String"/>
  <field name="docDate"     class="java.sql.Date"/>
  <field name="docType"     class="java.lang.String"/>
  <field name="docNo"       class="java.lang.String"/>
  <field name="seqNo"       class="java.lang.String"/>
  <field name="amt"         class="java.math.BigDecimal"/>
  <field name="retentAmt"   class="java.math.BigDecimal"/>
  <field name="debit"       class="java.math.BigDecimal"/>
  <field name="credit"      class="java.math.BigDecimal"/>
  <field name="amtPaid"     class="java.math.BigDecimal"/>
  <field name="discTaken"   class="java.math.BigDecimal"/>
  <field name="balance"     class="java.math.BigDecimal"/>
  <field name="lineNo"      class="java.lang.Integer"/>
  <field name="lineType"    class="java.lang.String"/>
  <field name="glAcctMain"  class="java.lang.Integer"/>
  <field name="glAcctSub"   class="java.lang.Integer"/>
  <field name="amtExTax"    class="java.math.BigDecimal"/>
  <field name="taxCode"     class="java.lang.String"/>
  <field name="lineTaxAmt"  class="java.math.BigDecimal"/>
  <field name="description" class="java.lang.String"/>

  <variable name="GRP_DEBIT"   class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="custGroup"><variableExpression><![CDATA[$F{debit}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="GRP_CREDIT"  class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="custGroup"><variableExpression><![CDATA[$F{credit}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="GRP_BALANCE" class="java.math.BigDecimal" calculation="Sum" resetType="Group" resetGroup="custGroup"><variableExpression><![CDATA[$F{balance}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

  <group name="custGroup">
    <groupExpression><![CDATA[$F{custNo}]]></groupExpression>
    <groupHeader>
      <band height="18">
        <rectangle><reportElement x="0" y="2" width="782" height="15" backcolor="#dbe2ef"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField isStretchWithOverflow="true"><reportElement x="4" y="3" width="600" height="13" mode="Opaque" backcolor="#dbe2ef"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{custNo} + "  " + ($F{name}==null?"":$F{name})]]></textFieldExpression></textField>
        <textField><reportElement x="610" y="3" width="168" height="13" mode="Opaque" backcolor="#dbe2ef"/><textElement textAlignment="Right"><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA["Sub ledger " + ($F{subLedger}==null?"":$F{subLedger}) + " " + ($F{subLedgerName}==null?"":$F{subLedgerName})]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="16">
        <line><reportElement x="222" y="1" width="500" height="1" forecolor="#888888"/></line>
        <textField><reportElement x="4" y="2" width="200" height="12"/><textElement><font size="8" isBold="true" isItalic="true"/></textElement><textFieldExpression><![CDATA["Customer " + $F{custNo} + " total"]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="354" y="2" width="70" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_DEBIT}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="426" y="2" width="70" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_CREDIT}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="624" y="2" width="98" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_BALANCE}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="64">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Transaction Listing]]></text></staticText>
      <textField><reportElement x="0" y="22" width="500" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA["By " + $P{PRINT_SEQ_DESC} + "  •  " + $P{CUST_RANGE} + "  •  " + $P{SUB_LEDGER_DESC}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="50" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$P{DATE_BASIS_DESC} + "  •  " + $P{DATE_RANGE}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Doc Date]]></text></staticText>
      <staticText><reportElement x="64"  y="4" width="32" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="98"  y="4" width="78" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Doc No]]></text></staticText>
      <staticText><reportElement x="178" y="4" width="42" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Seq]]></text></staticText>
      <staticText><reportElement x="222" y="4" width="70" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
      <staticText><reportElement x="294" y="4" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Retent]]></text></staticText>
      <staticText><reportElement x="354" y="4" width="70" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Debit]]></text></staticText>
      <staticText><reportElement x="426" y="4" width="70" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Credit]]></text></staticText>
      <staticText><reportElement x="498" y="4" width="64" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amt Paid]]></text></staticText>
      <staticText><reportElement x="564" y="4" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Disc]]></text></staticText>
      <staticText><reportElement x="624" y="4" width="98" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Outstanding]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <printWhenExpression><![CDATA["T".equals($F{rowType}) && !$P{SUMMARY_MODE}.booleanValue()]]></printWhenExpression>
      <textField pattern="dd/MM/yyyy"><reportElement x="4" y="1" width="58" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
      <textField><reportElement x="64" y="1" width="32" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField><reportElement x="98" y="1" width="78" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField><reportElement x="178" y="1" width="42" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{seqNo}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="222" y="1" width="70" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="294" y="1" width="58" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{retentAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="354" y="1" width="70" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="426" y="1" width="70" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="498" y="1" width="64" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amtPaid}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="564" y="1" width="58" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{discTaken}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="624" y="1" width="98" height="11"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression></textField>
    </band>
    <band height="11">
      <printWhenExpression><![CDATA["L".equals($F{rowType}) && !$P{SUMMARY_MODE}.booleanValue()]]></printWhenExpression>
      <textField><reportElement x="24" y="0" width="150" height="10"/><textElement><font size="7" isItalic="true"/></textElement><textFieldExpression><![CDATA["  GL " + $F{glAcctMain} + "-" + $F{glAcctSub} + " (" + ($F{lineType}==null?"":$F{lineType}) + ")"]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="178" y="0" width="220" height="10"/><textElement><font size="7" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="222" y="0" width="70" height="10" forecolor="#444444"/><textElement textAlignment="Right"><font size="7" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{amtExTax}]]></textFieldExpression></textField>
      <textField><reportElement x="498" y="0" width="20" height="10"/><textElement><font size="7" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{taxCode}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="520" y="0" width="60" height="10" forecolor="#444444"/><textElement textAlignment="Right"><font size="7" isItalic="true"/></textElement><textFieldExpression><![CDATA[$F{lineTaxAmt}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="120">
      <line><reportElement x="0" y="4" width="782" height="1" forecolor="#1e2d45"/><graphicElement><pen lineWidth="1"/></graphicElement></line>
      <staticText><reportElement x="0" y="8" width="300" height="14"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[Report Totals]]></text></staticText>

      <staticText><reportElement x="0"   y="26" width="120" height="12"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="120" y="26" width="60"  height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Count]]></text></staticText>
      <staticText><reportElement x="184" y="26" width="120" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>

      <staticText><reportElement x="0" y="40" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Invoices]]></text></staticText>
      <textField><reportElement x="120" y="40" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_INV_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="40" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_INV_AMT}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="52" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Debit notes]]></text></staticText>
      <textField><reportElement x="120" y="52" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_DR_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="52" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_DR_AMT}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="64" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Credit notes]]></text></staticText>
      <textField><reportElement x="120" y="64" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_CR_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="64" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_CR_AMT}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="76" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Payments]]></text></staticText>
      <textField><reportElement x="120" y="76" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_PAY_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="76" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_PAY_AMT}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="88" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Dishonour chqs]]></text></staticText>
      <textField><reportElement x="120" y="88" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_VOID_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="88" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_VOID_AMT}]]></textFieldExpression></textField>

      <staticText><reportElement x="0" y="100" width="120" height="11"/><textElement><font size="8"/></textElement><text><![CDATA[Balances]]></text></staticText>
      <textField><reportElement x="120" y="100" width="60" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_BAL_NO}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="184" y="100" width="120" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$P{T_BAL_AMT}]]></textFieldExpression></textField>

      <line><reportElement x="0" y="113" width="320" height="1" forecolor="#888888"/></line>
      <textField><reportElement x="360" y="40" width="200" height="12"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Transactions: " + ($P{GRAND_NO}==null?0:$P{GRAND_NO})]]></textFieldExpression></textField>
      <staticText><reportElement x="360" y="56" width="160" height="12"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Grand total (net):]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="520" y="56" width="120" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
