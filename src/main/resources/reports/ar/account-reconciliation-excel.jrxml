<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="account-reconciliation-excel"
              pageWidth="1760" pageHeight="595" orientation="Landscape"
              columnWidth="1720" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="CUST_DESC"    class="java.lang.String"  isForPrompting="false"/>
  <parameter name="AMT_BASIS"    class="java.lang.String"  isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="custNo"           class="java.lang.String"/>
  <field name="name"             class="java.lang.String"/>
  <field name="reconNo"          class="java.lang.Integer"/>
  <field name="reconOutstanding" class="java.math.BigDecimal"/>
  <field name="reconGross"       class="java.math.BigDecimal"/>
  <field name="reconClaim"       class="java.math.BigDecimal"/>
  <field name="seqNo"            class="java.lang.String"/>
  <field name="docType"          class="java.lang.String"/>
  <field name="docNo"            class="java.lang.String"/>
  <field name="docDate"          class="java.sql.Date"/>
  <field name="forCurrCode"      class="java.lang.String"/>
  <field name="gross"            class="java.math.BigDecimal"/>
  <field name="retentAmt"        class="java.math.BigDecimal"/>
  <field name="amtPaid"          class="java.math.BigDecimal"/>
  <field name="discTaken"        class="java.math.BigDecimal"/>
  <field name="net"              class="java.math.BigDecimal"/>

  <title>
    <band height="22">
      <textField><reportElement x="0" y="0" width="1200" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Account Reconciliation — " + $P{COMPANY_NAME} + "  (" + ($P{CUST_DESC}==null?"":$P{CUST_DESC}) + ", " + ($P{AMT_BASIS}==null?"":$P{AMT_BASIS}) + ")"]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="16">
      <staticText><reportElement x="0"    y="0" width="70"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Customer No]]></text></staticText>
      <staticText><reportElement x="70"   y="0" width="170" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Customer Name]]></text></staticText>
      <staticText><reportElement x="240"  y="0" width="60"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Recon No]]></text></staticText>
      <staticText><reportElement x="300"  y="0" width="100" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#3a4a63"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Recon Outstanding Bal]]></text></staticText>
      <staticText><reportElement x="400"  y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#3a4a63"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Recon Gross Bal]]></text></staticText>
      <staticText><reportElement x="490"  y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#3a4a63"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Recon Claim Bal]]></text></staticText>
      <staticText><reportElement x="580"  y="0" width="50"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Seq No]]></text></staticText>
      <staticText><reportElement x="630"  y="0" width="70"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Document Type]]></text></staticText>
      <staticText><reportElement x="700"  y="0" width="110" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Document No]]></text></staticText>
      <staticText><reportElement x="810"  y="0" width="70"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Document Date]]></text></staticText>
      <staticText><reportElement x="880"  y="0" width="50"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Currency]]></text></staticText>
      <staticText><reportElement x="930"  y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Gross Amount]]></text></staticText>
      <staticText><reportElement x="1020" y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Retention Amount]]></text></staticText>
      <staticText><reportElement x="1110" y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount Paid]]></text></staticText>
      <staticText><reportElement x="1200" y="0" width="80"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Discount Taken]]></text></staticText>
      <staticText><reportElement x="1280" y="0" width="90"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Net Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"    y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{custNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="70" y="0" width="170" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField><reportElement x="240"  y="0" width="60"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reconNo}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="300"  y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reconOutstanding}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="400"  y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reconGross}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="490"  y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reconClaim}]]></textFieldExpression></textField>
      <textField><reportElement x="580"  y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{seqNo}]]></textFieldExpression></textField>
      <textField><reportElement x="630"  y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField><reportElement x="700"  y="0" width="110" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="810"  y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
      <textField><reportElement x="880"  y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{forCurrCode}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="930"  y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{gross}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1020" y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{retentAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1110" y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amtPaid}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1200" y="0" width="80"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{discTaken}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1280" y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{net}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <staticText><reportElement x="1160" y="4" width="118" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Grand total:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1280" y="4" width="90" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
