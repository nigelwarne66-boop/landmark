<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="customer-sales"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NO"     class="java.lang.Integer"/>
  <parameter name="COMPANY_NAME"   class="java.lang.String"/>
  <parameter name="GROUP_BY"       class="java.lang.String"  isForPrompting="false"/>
  <parameter name="PERIOD_END"     class="java.lang.String"  isForPrompting="false"/>
  <parameter name="THIS_YR"        class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="LAST_YR"        class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="SHOW_LAST_YR"   class="java.lang.Boolean" isForPrompting="false"/>
  <parameter name="SUM_SALES"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_COST"       class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_SALES_LAST" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_PROFIT"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"      class="java.lang.Integer" isForPrompting="false"/>

  <field name="groupKey"    class="java.lang.String"/>
  <field name="custNo"      class="java.lang.String"/>
  <field name="name"        class="java.lang.String"/>
  <field name="subLedger"   class="java.lang.String"/>
  <field name="salesYtd"    class="java.math.BigDecimal"/>
  <field name="costYtd"     class="java.math.BigDecimal"/>
  <field name="profit"      class="java.math.BigDecimal"/>
  <field name="profitPct"   class="java.math.BigDecimal"/>
  <field name="salesLastYtd" class="java.math.BigDecimal"/>
  <field name="salesVar"    class="java.math.BigDecimal"/>

  <variable name="GRP_SALES"      class="java.math.BigDecimal" resetType="Group" resetGroup="groupKeyGroup" calculation="Sum"><variableExpression><![CDATA[$F{salesYtd}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="GRP_COST"       class="java.math.BigDecimal" resetType="Group" resetGroup="groupKeyGroup" calculation="Sum"><variableExpression><![CDATA[$F{costYtd}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="GRP_SALES_LAST" class="java.math.BigDecimal" resetType="Group" resetGroup="groupKeyGroup" calculation="Sum"><variableExpression><![CDATA[$F{salesLastYtd}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="GRP_PROFIT"     class="java.math.BigDecimal" resetType="Group" resetGroup="groupKeyGroup" calculation="Sum"><variableExpression><![CDATA[$F{profit}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

  <group name="groupKeyGroup">
    <groupExpression><![CDATA[$F{groupKey}]]></groupExpression>
    <groupHeader>
      <band height="16">
        <textField><reportElement x="2" y="2" width="200" height="12"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GROUP_BY} + ": " + $F{groupKey}]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="16">
        <line><reportElement x="0" y="0" width="782" height="1" forecolor="#cccccc"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
        <staticText><reportElement x="2" y="2" width="190" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true" isItalic="true"/></textElement><text><![CDATA[Group total:]]></text></staticText>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="194" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_SALES}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="296" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_COST}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="398" y="2" width="100" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_PROFIT}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="600" y="2" width="100" height="12"><printWhenExpression><![CDATA[$P{SHOW_LAST_YR}]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{GRP_SALES_LAST}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="54">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Customer Sales]]></text></staticText>
      <textField><reportElement x="0" y="22" width="500" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA["Grouped by " + $P{GROUP_BY} + "   Period ending: " + $P{PERIOD_END} + "   Year: " + $P{THIS_YR}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="38" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="2"   y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Customer]]></text></staticText>
      <staticText><reportElement x="54"  y="4" width="140" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Name]]></text></staticText>
      <staticText><reportElement x="196" y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger]]></text></staticText>
      <staticText><reportElement x="248" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Sales YTD]]></text></staticText>
      <staticText><reportElement x="350" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Cost YTD]]></text></staticText>
      <staticText><reportElement x="452" y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Profit]]></text></staticText>
      <staticText><reportElement x="534" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Profit %]]></text></staticText>
      <staticText><reportElement x="596" y="4" width="94"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Last Yr Sales]]></text></staticText>
      <staticText><reportElement x="692" y="4" width="88"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Variance]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="2"   y="1" width="50"  height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{custNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="54" y="1" width="140" height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField><reportElement x="196" y="1" width="50"  height="12"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="248" y="1" width="100" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesYtd}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="350" y="1" width="100" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{costYtd}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="452" y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{profit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement x="534" y="1" width="60"  height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{profitPct}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="596" y="1" width="94" height="12"><printWhenExpression><![CDATA[$P{SHOW_LAST_YR}]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesLastYtd}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="692" y="1" width="88" height="12"><printWhenExpression><![CDATA[$P{SHOW_LAST_YR}]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesVar}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <line><reportElement x="0" y="2" width="782" height="1" forecolor="#1e2d45"/><graphicElement><pen lineWidth="1"/></graphicElement></line>
      <textField><reportElement x="2" y="6" width="200" height="12"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{ROW_COUNT} + " customer(s) — Grand total"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="248" y="6" width="100" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_SALES}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="350" y="6" width="100" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_COST}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="452" y="6" width="80"  height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_PROFIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="596" y="6" width="94" height="12"><printWhenExpression><![CDATA[$P{SHOW_LAST_YR}]]></printWhenExpression></reportElement><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_SALES_LAST}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
