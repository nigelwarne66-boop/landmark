<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="customer-sales-by-year-excel"
              pageWidth="1000" pageHeight="595" orientation="Landscape"
              columnWidth="960" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="CUST_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATE_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="YR1_LABEL"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="YR2_LABEL"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="YR3_LABEL"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="YR4_LABEL"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="YR5_LABEL"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUM_YR1"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YR2"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YR3"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YR4"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_YR5"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_TOTAL" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT" class="java.lang.Integer"   isForPrompting="false"/>

  <field name="custNo" class="java.lang.String"/>
  <field name="name"   class="java.lang.String"/>
  <field name="yr1"    class="java.math.BigDecimal"/>
  <field name="yr2"    class="java.math.BigDecimal"/>
  <field name="yr3"    class="java.math.BigDecimal"/>
  <field name="yr4"    class="java.math.BigDecimal"/>
  <field name="yr5"    class="java.math.BigDecimal"/>
  <field name="total"  class="java.math.BigDecimal"/>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="960" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Customer Sales by Year]]></text></staticText>
      <textField><reportElement x="0" y="20" width="960" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{CUST_RANGE} + " • " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer No]]></text></staticText>
      <staticText><reportElement x="90"  y="0" width="250" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer Name]]></text></staticText>
      <textField><reportElement x="340" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Sales " + $P{YR1_LABEL}]]></textFieldExpression></textField>
      <textField><reportElement x="440" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Sales " + $P{YR2_LABEL}]]></textFieldExpression></textField>
      <textField><reportElement x="540" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Sales " + $P{YR3_LABEL}]]></textFieldExpression></textField>
      <textField><reportElement x="640" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Sales " + $P{YR4_LABEL}]]></textFieldExpression></textField>
      <textField><reportElement x="740" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Sales " + $P{YR5_LABEL}]]></textFieldExpression></textField>
      <staticText><reportElement x="840" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Total Sales]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="90"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{custNo}]]></textFieldExpression></textField>
      <textField><reportElement x="90"  y="0" width="250" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="340" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{yr1}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="440" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{yr2}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="540" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{yr3}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="640" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{yr4}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="740" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{yr5}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="840" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="340" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " customer(s) — Total"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="340" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YR1}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="440" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YR2}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="540" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YR3}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="640" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YR4}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="740" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_YR5}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="840" y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
