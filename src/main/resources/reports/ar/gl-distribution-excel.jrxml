<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="gl-distribution-excel"
              pageWidth="1000" pageHeight="595" orientation="Landscape"
              columnWidth="960" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.3" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NO"       class="java.lang.Integer"/>
  <parameter name="COMPANY_NAME"     class="java.lang.String"/>
  <parameter name="PERIOD_END"       class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUB_LEDGER_DESC"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="TOTAL_CONTROL"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="TOTAL_SALES"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"        class="java.lang.Integer" isForPrompting="false"/>

  <field name="glAcctMain" class="java.lang.Integer"/>
  <field name="glAcctSub"  class="java.lang.Integer"/>
  <field name="glDesc"     class="java.lang.String"/>
  <field name="acctType"   class="java.lang.String"/>
  <field name="subLedger"  class="java.lang.String"/>
  <field name="amt"        class="java.math.BigDecimal"/>

  <variable name="SUM_AMT" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{amt}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <title>
    <band height="36">
      <staticText><reportElement x="0" y="0" width="600" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[GL Distribution]]></text></staticText>
      <textField><reportElement x="0" y="20" width="960" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   Period ending: " + $P{PERIOD_END} + "   Sub ledger: " + $P{SUB_LEDGER_DESC}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GL Account Main]]></text></staticText>
      <staticText><reportElement x="80"  y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GL Account Sub]]></text></staticText>
      <staticText><reportElement x="150" y="0" width="350" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GL Description]]></text></staticText>
      <staticText><reportElement x="500" y="0" width="130" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Account Type]]></text></staticText>
      <staticText><reportElement x="630" y="0" width="130" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger]]></text></staticText>
      <staticText><reportElement x="760" y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glAcctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="80"  y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glAcctSub}]]></textFieldExpression></textField>
      <textField><reportElement x="150" y="0" width="350" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glDesc}]]></textFieldExpression></textField>
      <textField><reportElement x="500" y="0" width="130" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctType}]]></textFieldExpression></textField>
      <textField><reportElement x="630" y="0" width="130" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="760" y="0" width="200" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amt}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="40">
      <textField><reportElement x="0" y="4" width="500" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{ROW_COUNT} + " row(s)   Total Control: "]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="500" y="4" width="200" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_CONTROL}]]></textFieldExpression></textField>
      <staticText><reportElement x="0" y="22" width="500" height="14"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Sales:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="500" y="22" width="200" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{TOTAL_SALES}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
