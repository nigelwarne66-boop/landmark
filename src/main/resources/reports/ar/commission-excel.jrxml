<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="commission-excel"
              pageWidth="2000" pageHeight="595" orientation="Landscape"
              columnWidth="1960" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"   class="java.lang.String"/>
  <parameter name="SALESMAN_RANGE" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DATE_RANGE"     class="java.lang.String"  isForPrompting="false"/>
  <parameter name="SUM_SALE"       class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_COMMISSION" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"      class="java.lang.Integer"    isForPrompting="false"/>

  <field name="salesman"     class="java.lang.String"/>
  <field name="salesmanName" class="java.lang.String"/>
  <field name="docDate"      class="java.sql.Date"/>
  <field name="docType"      class="java.lang.String"/>
  <field name="retentFlag"   class="java.lang.String"/>
  <field name="docNo"        class="java.lang.String"/>
  <field name="custNo"       class="java.lang.String"/>
  <field name="name"         class="java.lang.String"/>
  <field name="docAmt"       class="java.math.BigDecimal"/>
  <field name="saleAmt"      class="java.math.BigDecimal"/>
  <field name="commPct"      class="java.math.BigDecimal"/>
  <field name="commission"   class="java.math.BigDecimal"/>

  <variable name="SUM_SALE_V"       class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{saleAmt}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="SUM_COMMISSION_V" class="java.math.BigDecimal" calculation="Sum">
    <variableExpression><![CDATA[$F{commission}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="600" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Commission Report]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1400" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{SALESMAN_RANGE} + "  •  " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Salesman]]></text></staticText>
      <staticText><reportElement x="80"   y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Salesman Name]]></text></staticText>
      <staticText><reportElement x="280"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document Date]]></text></staticText>
      <staticText><reportElement x="360"  y="0" width="50"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="410"  y="0" width="40"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Ret]]></text></staticText>
      <staticText><reportElement x="450"  y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document No]]></text></staticText>
      <staticText><reportElement x="550"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer No]]></text></staticText>
      <staticText><reportElement x="630"  y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Customer Name]]></text></staticText>
      <staticText><reportElement x="830"  y="0" width="110" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document Amount]]></text></staticText>
      <staticText><reportElement x="940"  y="0" width="110" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sale Amount]]></text></staticText>
      <staticText><reportElement x="1050" y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Commission %]]></text></staticText>
      <staticText><reportElement x="1140" y="0" width="110" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Commission]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"    y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesman}]]></textFieldExpression></textField>
      <textField><reportElement x="80"   y="0" width="200" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesmanName}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="280" y="0" width="80" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
      <textField><reportElement x="360"  y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField><reportElement x="410"  y="0" width="40"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{retentFlag}]]></textFieldExpression></textField>
      <textField><reportElement x="450"  y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField><reportElement x="550"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{custNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="630" y="0" width="200" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="830"  y="0" width="110" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="940"  y="0" width="110" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{saleAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1050" y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{commPct}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1140" y="0" width="110" height="14"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{commission}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="500" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " transaction(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="940"  y="3" width="110" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_SALE_V}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1140" y="3" width="110" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_COMMISSION_V}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
