<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="report-writer-excel"
              pageWidth="1400" pageHeight="595" orientation="Landscape"
              columnWidth="1340" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false"/>
  <parameter name="VERT_DESC"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="HORIZ_DESC"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="YEAR_DESC"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_COUNT"    class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="COL_HEAD_01"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_02"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_03"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_04"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_05"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_06"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_07"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_08"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_09"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_10"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_11"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_12"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_13"  class="java.lang.String" isForPrompting="false"/>

  <field name="rowLabel" class="java.lang.String"/>
  <field name="rowKind"  class="java.lang.String"/>
  <field name="col_01"   class="java.math.BigDecimal"/>
  <field name="col_02"   class="java.math.BigDecimal"/>
  <field name="col_03"   class="java.math.BigDecimal"/>
  <field name="col_04"   class="java.math.BigDecimal"/>
  <field name="col_05"   class="java.math.BigDecimal"/>
  <field name="col_06"   class="java.math.BigDecimal"/>
  <field name="col_07"   class="java.math.BigDecimal"/>
  <field name="col_08"   class="java.math.BigDecimal"/>
  <field name="col_09"   class="java.math.BigDecimal"/>
  <field name="col_10"   class="java.math.BigDecimal"/>
  <field name="col_11"   class="java.math.BigDecimal"/>
  <field name="col_12"   class="java.math.BigDecimal"/>
  <field name="col_13"   class="java.math.BigDecimal"/>

  <title>
    <band height="40">
      <textField><reportElement x="0" y="0" width="600" height="18"/><textElement><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="20" width="1340" height="14"/><textElement><font size="10"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + ($P{VERT_DESC}==null?"":$P{VERT_DESC}) + "  •  " + $P{HORIZ_DESC} + "  •  " + $P{YEAR_DESC}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="1340" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"    y="4" width="240" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <textField><reportElement x="246"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_01}]]></textFieldExpression></textField>
      <textField><reportElement x="328"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_02}]]></textFieldExpression></textField>
      <textField><reportElement x="410"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_03}]]></textFieldExpression></textField>
      <textField><reportElement x="492"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_04}]]></textFieldExpression></textField>
      <textField><reportElement x="574"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_05}]]></textFieldExpression></textField>
      <textField><reportElement x="656"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_06}]]></textFieldExpression></textField>
      <textField><reportElement x="738"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_07}]]></textFieldExpression></textField>
      <textField><reportElement x="820"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_08}]]></textFieldExpression></textField>
      <textField><reportElement x="902"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_09}]]></textFieldExpression></textField>
      <textField><reportElement x="984"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_10}]]></textFieldExpression></textField>
      <textField><reportElement x="1066" y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_11}]]></textFieldExpression></textField>
      <textField><reportElement x="1148" y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_12}]]></textFieldExpression></textField>
      <textField><reportElement x="1230" y="4" width="106" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_13}]]></textFieldExpression></textField>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField isStretchWithOverflow="true"><reportElement x="4" y="1" width="240" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{rowLabel}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="246"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_01}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="328"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_02}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="410"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_03}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="492"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_04}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="574"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_05}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="656"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_06}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="738"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_07}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="820"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_08}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="902"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_09}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="984"  y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_10}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1066" y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_11}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1148" y="1" width="80"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_12}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1230" y="1" width="106" height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{col_13}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="0"/>
  </pageFooter>

  <summary>
    <band height="22">
      <textField><reportElement x="4" y="6" width="600" height="12"/><textElement><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s) — " + ($P{COL_COUNT}==null?0:$P{COL_COUNT}) + " column(s)"]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
