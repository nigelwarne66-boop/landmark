<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="report-writer"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <!-- rowKind-driven row styles: header=section divider, subtotal=leaf total, total=grand total -->
  <style name="rowLabel" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["subtotal".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#e2ecf6" forecolor="#1e2d45" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>
  <style name="rowNum" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#506680"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["subtotal".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#e2ecf6" forecolor="#1e2d45" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="REPORT_TITLE" class="java.lang.String" isForPrompting="false"/>
  <parameter name="VERT_DESC"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="HORIZ_DESC"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="YEAR_DESC"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_COUNT"    class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer" isForPrompting="false"/>
  <parameter name="COL_HEAD_01"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_02"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_03"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_04"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_05"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_06"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_07"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_08"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_09"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_10"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_11"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_12"  class="java.lang.String" isForPrompting="false"/>
  <parameter name="COL_HEAD_13"  class="java.lang.String" isForPrompting="false"/>

  <field name="rowLabel" class="java.lang.String"/>
  <field name="rowKind"  class="java.lang.String"/>
  <field name="col_01"   class="java.math.BigDecimal"/>
  <field name="col_02"   class="java.math.BigDecimal"/>
  <field name="col_03"   class="java.math.BigDecimal"/>
  <field name="col_04"   class="java.math.BigDecimal"/>
  <field name="col_05"   class="java.math.BigDecimal"/>
  <field name="col_06"   class="java.math.BigDecimal"/>
  <field name="col_07"   class="java.math.BigDecimal"/>
  <field name="col_08"   class="java.math.BigDecimal"/>
  <field name="col_09"   class="java.math.BigDecimal"/>
  <field name="col_10"   class="java.math.BigDecimal"/>
  <field name="col_11"   class="java.math.BigDecimal"/>
  <field name="col_12"   class="java.math.BigDecimal"/>
  <field name="col_13"   class="java.math.BigDecimal"/>

  <title>
    <band height="48">
      <textField><reportElement x="0" y="0" width="500" height="18"/><textElement><font size="13" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{REPORT_TITLE}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="20" width="560" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{YEAR_DESC}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy HH:mm"><reportElement x="600" y="20" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="172" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <textField><reportElement x="178" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_01}]]></textFieldExpression></textField>
      <textField><reportElement x="225" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_02}]]></textFieldExpression></textField>
      <textField><reportElement x="272" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_03}]]></textFieldExpression></textField>
      <textField><reportElement x="319" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_04}]]></textFieldExpression></textField>
      <textField><reportElement x="366" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_05}]]></textFieldExpression></textField>
      <textField><reportElement x="413" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_06}]]></textFieldExpression></textField>
      <textField><reportElement x="460" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_07}]]></textFieldExpression></textField>
      <textField><reportElement x="507" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_08}]]></textFieldExpression></textField>
      <textField><reportElement x="554" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_09}]]></textFieldExpression></textField>
      <textField><reportElement x="601" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_10}]]></textFieldExpression></textField>
      <textField><reportElement x="648" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_11}]]></textFieldExpression></textField>
      <textField><reportElement x="695" y="4" width="46"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_12}]]></textFieldExpression></textField>
      <textField><reportElement x="742" y="4" width="40"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="7" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{COL_HEAD_13}]]></textFieldExpression></textField>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <rectangle><reportElement x="0" y="0" width="782" height="13" backcolor="#506680" forecolor="#506680"><printWhenExpression><![CDATA["header".equals($F{rowKind})]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <rectangle><reportElement x="0" y="0" width="782" height="13" backcolor="#e2ecf6" forecolor="#e2ecf6"><printWhenExpression><![CDATA["subtotal".equals($F{rowKind})]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <rectangle><reportElement x="0" y="0" width="782" height="13" backcolor="#1e2d45" forecolor="#1e2d45"><printWhenExpression><![CDATA["total".equals($F{rowKind})]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement style="rowLabel" x="4" y="1" width="172" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{rowLabel}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="178" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_01}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="225" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_02}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="272" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_03}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="319" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_04}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="366" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_05}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="413" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_06}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="460" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_07}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="507" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_08}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="554" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_09}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="601" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_10}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="648" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_11}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="695" y="1" width="46" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_12}]]></textFieldExpression></textField>
      <textField pattern="#,##0;(#,##0)"><reportElement style="rowNum" x="742" y="1" width="40" height="11"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA[$F{col_13}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd-MM-yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="22">
      <rectangle><reportElement x="0" y="0" width="782" height="22" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="4" y="6" width="400" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s) — " + ($P{COL_COUNT}==null?0:$P{COL_COUNT}) + " column(s)"]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
