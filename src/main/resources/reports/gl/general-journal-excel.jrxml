<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="general-journal-excel"
              pageWidth="1460" pageHeight="595" orientation="Landscape"
              columnWidth="1460" leftMargin="0" rightMargin="0"
              topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1"            value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2"            value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background"            value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins"              value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"  class="java.lang.String"/>
  <parameter name="YEAR_DESC"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SOURCE_DESC"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="JNL_RANGE"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="MODE_DESC"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_DEBIT"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_CREDIT"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"     class="java.lang.Integer"    isForPrompting="false"/>

  <field name="rowType"     class="java.lang.String"/>
  <field name="source"      class="java.lang.String"/>
  <field name="journal"     class="java.lang.String"/>
  <field name="jnlDate"     class="java.sql.Date"/>
  <field name="acctMain"    class="java.lang.String"/>
  <field name="acctSub"     class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="reference"   class="java.lang.String"/>
  <field name="debit"       class="java.math.BigDecimal"/>
  <field name="credit"      class="java.math.BigDecimal"/>
  <field name="user"        class="java.lang.String"/>

  <title>
    <band height="28">
      <staticText><reportElement x="0" y="0" width="1460" height="16"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[General Journal]]></text></staticText>
      <textField><reportElement x="0" y="16" width="1460" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{YEAR_DESC}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Source]]></text></staticText>
      <staticText><reportElement x="80"   y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Journal]]></text></staticText>
      <staticText><reportElement x="180"  y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Journal Date]]></text></staticText>
      <staticText><reportElement x="270"  y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Account]]></text></staticText>
      <staticText><reportElement x="330"  y="0" width="30"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub]]></text></staticText>
      <staticText><reportElement x="360"  y="0" width="300" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="660"  y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="860"  y="0" width="140" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Debit]]></text></staticText>
      <staticText><reportElement x="1000" y="0" width="140" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Credit]]></text></staticText>
      <staticText><reportElement x="1140" y="0" width="320" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[User]]></text></staticText>
    </band>
  </columnHeader>

  <!-- Single detail band — three sibling bands each gated by a band-level
       printWhenExpression (header/data/total) is the documented "three-band
       printWhenExpression bug": Jasper silently drops a sibling band's rows
       once another sibling's condition has been evaluated for that same
       record. general-journal.jrxml (the PDF sibling of this report) was
       already fixed to use one band with element-level printWhenExpression
       per field; this mirrors that fix so Excel detail lines actually render. -->
  <detail>
    <band height="16">
      <!-- Row-kind background fills -->
      <rectangle>
        <reportElement x="0" y="0" width="1460" height="16" backcolor="#506680" forecolor="#506680">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>
      <rectangle>
        <reportElement x="0" y="0" width="1460" height="16" backcolor="#1e2d45" forecolor="#1e2d45">
          <printWhenExpression><![CDATA["total".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>

      <!-- Header row: journal + date label spanning the left columns -->
      <textField>
        <reportElement x="0" y="0" width="180" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#506680">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{journal}]]></textFieldExpression>
      </textField>
      <textField pattern="dd-MM-yyyy">
        <reportElement x="180" y="0" width="90" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#506680">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement verticalAlignment="Middle"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{jnlDate}]]></textFieldExpression>
      </textField>

      <!-- Data rows -->
      <textField><reportElement x="0"    y="0" width="80"  height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{source}]]></textFieldExpression></textField>
      <textField><reportElement x="80"   y="0" width="100" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{journal}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy"><reportElement x="180" y="0" width="90" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{jnlDate}]]></textFieldExpression></textField>
      <textField><reportElement x="270"  y="0" width="60"  height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="330"  y="0" width="30"  height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctSub}]]></textFieldExpression></textField>
      <textField><reportElement x="360"  y="0" width="300" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField><reportElement x="660"  y="0" width="200" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="860"  y="0" width="140" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1000" y="0" width="140" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression></textField>
      <textField><reportElement x="1140" y="0" width="320" height="16"><printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression></reportElement><textElement verticalAlignment="Middle"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{user}]]></textFieldExpression></textField>

      <!-- Total row -->
      <staticText>
        <reportElement x="0" y="0" width="860" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45">
          <printWhenExpression><![CDATA["total".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
        <text><![CDATA[Journal Total:]]></text>
      </staticText>
      <textField pattern="#,##0.00;(#,##0.00)">
        <reportElement x="860" y="0" width="140" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45">
          <printWhenExpression><![CDATA["total".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)">
        <reportElement x="1000" y="0" width="140" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45">
          <printWhenExpression><![CDATA["total".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <pageFooter>
    <band height="0"/>
  </pageFooter>

  <summary>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="1460" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField><reportElement x="0" y="3" width="860" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="860"  y="3" width="140" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_DEBIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1000" y="3" width="140" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_CREDIT}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
