<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="profit-loss"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_RANGE" class="java.lang.String" isForPrompting="false"/>
  <parameter name="ACCT_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUM_INCOME"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_EXPENSE"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="NET_PROFIT"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="section"     class="java.lang.String"/>
  <field name="account"     class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="amount"      class="java.math.BigDecimal"/>

  <variable name="SECTION_TOTAL" class="java.math.BigDecimal"
            resetType="Group" resetGroup="SectionGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <group name="SectionGroup">
    <groupExpression><![CDATA[$F{section}]]></groupExpression>
    <groupHeader>
      <band height="22">
        <rectangle><reportElement x="0" y="4" width="782" height="16" backcolor="#e8edf5"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField><reportElement x="4" y="6" width="400" height="12"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{section}.toUpperCase()]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="20">
        <line><reportElement x="560" y="2" width="218" height="1" forecolor="#1e2d45"/><graphicElement><pen lineWidth="0.75"/></graphicElement></line>
        <textField><reportElement x="4" y="6" width="400" height="12"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total " + $F{section}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="6" width="216" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SECTION_TOTAL}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="52">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Profit & Loss Statement]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{PERIOD_RANGE} + "  •  " + $P{ACCT_RANGE}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Account]]></text></staticText>
      <staticText><reportElement x="88"  y="4" width="468" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="562" y="4" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4"   y="1" width="80"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{account}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="88" y="1" width="468" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="1" width="216" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="46">
      <line><reportElement x="0" y="2" width="782" height="1" forecolor="#1e2d45"/><graphicElement><pen lineWidth="1.5"/></graphicElement></line>
      <staticText><reportElement x="4" y="10" width="200" height="12"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Income:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="10" width="216" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_INCOME}]]></textFieldExpression></textField>
      <staticText><reportElement x="4" y="24" width="200" height="12"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Expenses:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="24" width="216" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_EXPENSE}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
