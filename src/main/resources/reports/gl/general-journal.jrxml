<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="general-journal"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"  class="java.lang.String"/>
  <parameter name="YEAR_DESC"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SOURCE_DESC"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="JNL_RANGE"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="MODE_DESC"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_DEBIT"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_CREDIT"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"     class="java.lang.Integer"    isForPrompting="false"/>

  <field name="source"      class="java.lang.String"/>
  <field name="journal"     class="java.lang.String"/>
  <field name="jnlDate"     class="java.sql.Date"/>
  <field name="acctMain"    class="java.lang.String"/>
  <field name="acctSub"     class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="reference"   class="java.lang.String"/>
  <field name="debit"       class="java.math.BigDecimal"/>
  <field name="credit"      class="java.math.BigDecimal"/>
  <field name="user"        class="java.lang.String"/>

  <variable name="JNL_DEBIT" class="java.math.BigDecimal"
            resetType="Group" resetGroup="JournalGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{debit}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>
  <variable name="JNL_CREDIT" class="java.math.BigDecimal"
            resetType="Group" resetGroup="JournalGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{credit}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <group name="JournalGroup">
    <groupExpression><![CDATA[$F{journal}]]></groupExpression>
    <groupHeader>
      <band height="16">
        <rectangle><reportElement x="0" y="0" width="782" height="16" backcolor="#506680"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField>
          <reportElement x="4" y="2" width="350" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#506680"/>
          <textElement><font size="8" isBold="true"/></textElement>
          <textFieldExpression><![CDATA[$F{journal}]]></textFieldExpression>
        </textField>
        <textField pattern="dd/MM/yyyy">
          <reportElement x="358" y="2" width="70" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#506680"/>
          <textElement><font size="8"/></textElement>
          <textFieldExpression><![CDATA[$F{jnlDate}]]></textFieldExpression>
        </textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="16">
        <rectangle><reportElement x="0" y="2" width="782" height="13" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <staticText><reportElement x="430" y="4" width="112" height="10" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Journal Total:]]></text></staticText>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="546" y="4" width="100" height="10" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{JNL_DEBIT}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="650" y="4" width="100" height="10" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{JNL_CREDIT}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="40">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[General Journal]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{YEAR_DESC}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="54"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Source]]></text></staticText>
      <staticText><reportElement x="62"  y="4" width="64"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Journal]]></text></staticText>
      <staticText><reportElement x="130" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
      <staticText><reportElement x="194" y="4" width="40"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Account]]></text></staticText>
      <staticText><reportElement x="234" y="4" width="24"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sub]]></text></staticText>
      <staticText><reportElement x="258" y="4" width="180" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="442" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="546" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Debit]]></text></staticText>
      <staticText><reportElement x="650" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Credit]]></text></staticText>
      <staticText><reportElement x="754" y="4" width="24"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[User]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4"   y="1" width="54"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{source}]]></textFieldExpression></textField>
      <textField><reportElement x="62"  y="1" width="64"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{journal}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="130" y="1" width="60" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{jnlDate}]]></textFieldExpression></textField>
      <textField><reportElement x="194" y="1" width="40"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="234" y="1" width="24"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctSub}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="258" y="1" width="180" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField><reportElement x="442" y="1" width="100" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="546" y="1" width="100" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="650" y="1" width="100" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression></textField>
      <textField><reportElement x="754" y="1" width="24"  height="11"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[$F{user}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <rectangle><reportElement x="0" y="2" width="782" height="26" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField><reportElement x="4" y="8" width="400" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="430" y="8" width="112" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Total Debit / Credit:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="546" y="8" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_DEBIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="650" y="8" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_CREDIT}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
