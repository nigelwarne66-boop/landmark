<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="profit-loss-excel"
              pageWidth="1160" pageHeight="595" orientation="Landscape"
              columnWidth="1160" leftMargin="0" rightMargin="0"
              topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_RANGE" class="java.lang.String" isForPrompting="false"/>
  <parameter name="ACCT_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUM_INCOME"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_EXPENSE"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="NET_PROFIT"   class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="section"     class="java.lang.String"/>
  <field name="acctMain"    class="java.lang.String"/>
  <field name="acctSub"     class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="amount"      class="java.math.BigDecimal"/>

  <variable name="SECTION_TOTAL" class="java.math.BigDecimal"
            resetType="Group" resetGroup="SectionGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{amount}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <group name="SectionGroup">
    <groupExpression><![CDATA[$F{section}]]></groupExpression>
    <groupHeader>
      <band height="18">
        <rectangle><reportElement x="0" y="0" width="1160" height="18" backcolor="#506680"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField><reportElement x="0" y="2" width="600" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#506680"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{section}.toUpperCase()]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="18">
        <rectangle><reportElement x="0" y="0" width="1160" height="18" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField><reportElement x="4" y="2" width="600" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total " + $F{section}]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="780" y="2" width="380" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SECTION_TOTAL}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="36">
      <staticText><reportElement x="0" y="0" width="600" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Profit & Loss Statement]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1160" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{PERIOD_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="160" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Section]]></text></staticText>
      <staticText><reportElement x="160" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Account]]></text></staticText>
      <staticText><reportElement x="260" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sub]]></text></staticText>
      <staticText><reportElement x="320" y="0" width="460" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="780" y="0" width="380" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="160" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{section}]]></textFieldExpression></textField>
      <textField><reportElement x="160" y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="260" y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctSub}]]></textFieldExpression></textField>
      <textField><reportElement x="320" y="0" width="460" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="780" y="0" width="380" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="64">
      <rectangle><reportElement x="0" y="0" width="1160" height="64" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="0" y="6" width="400" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Income:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="780" y="6" width="380" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_INCOME}]]></textFieldExpression></textField>
      <staticText><reportElement x="0" y="24" width="400" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Expenses:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="780" y="24" width="380" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_EXPENSE}]]></textFieldExpression></textField>
      <line><reportElement x="0" y="42" width="1160" height="1" forecolor="#8aabbf"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
      <staticText><reportElement x="0" y="46" width="400" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[Net Profit/(Loss):]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="780" y="46" width="380" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{NET_PROFIT}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
