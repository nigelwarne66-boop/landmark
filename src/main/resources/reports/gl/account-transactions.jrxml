<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="account-transactions"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <!-- Row-kind styles for header / total rows -->
  <style name="acctLabel" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>
  <style name="acctNum" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#506680"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>

  <parameter name="COMPANY_NAME"   class="java.lang.String"/>
  <parameter name="YEAR_DESC"      class="java.lang.String"     isForPrompting="false"/>
  <parameter name="ACCT_RANGE"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SOURCE_DESC"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="ANALYSIS_RANGE" class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_DEBIT"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_CREDIT"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"      class="java.lang.Integer"    isForPrompting="false"/>

  <field name="rowType"      class="java.lang.String"/>
  <field name="account"      class="java.lang.String"/>
  <field name="acctMain"     class="java.lang.String"/>
  <field name="acctSub"      class="java.lang.String"/>
  <field name="description"  class="java.lang.String"/>
  <field name="jnlDate"      class="java.sql.Date"/>
  <field name="source"       class="java.lang.String"/>
  <field name="journal"      class="java.lang.String"/>
  <field name="reference"    class="java.lang.String"/>
  <field name="analysisCode" class="java.lang.String"/>
  <field name="debit"        class="java.math.BigDecimal"/>
  <field name="credit"       class="java.math.BigDecimal"/>
  <field name="balance"      class="java.math.BigDecimal"/>
  <field name="user"         class="java.lang.String"/>

  <title>
    <band height="40">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Account Transactions]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{YEAR_DESC}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
      <staticText><reportElement x="68"  y="4" width="54"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Source]]></text></staticText>
      <staticText><reportElement x="126" y="4" width="70"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Journal]]></text></staticText>
      <staticText><reportElement x="200" y="4" width="100" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="304" y="4" width="70"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Analysis]]></text></staticText>
      <staticText><reportElement x="378" y="4" width="116" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Debit]]></text></staticText>
      <staticText><reportElement x="498" y="4" width="116" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Credit]]></text></staticText>
      <staticText><reportElement x="618" y="4" width="116" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Balance]]></text></staticText>
      <staticText><reportElement x="738" y="4" width="40"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[User]]></text></staticText>
    </band>
  </columnHeader>

  <!-- Single detail band — same pattern as report-writer.jrxml.
       All three row types (header / data / total) rendered via element-level
       printWhenExpression on background rectangles and conditional styles on
       textFields. No native Jasper groups; no band-level printWhenExpression.
       ALL textFields carry isStretchWithOverflow="true" to avoid the Jasper 6.21
       stretch-rendering bug. -->
  <detail>
    <band height="16">
      <!-- Background rectangles -->
      <rectangle>
        <reportElement x="0" y="0" width="782" height="16" backcolor="#506680" forecolor="#506680">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>
      <rectangle>
        <reportElement x="0" y="0" width="782" height="16" backcolor="#1e2d45" forecolor="#1e2d45">
          <printWhenExpression><![CDATA["total".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>

      <!-- Account label — shows for header and total rows, hidden for data rows.
           For header: "1000.10  —  Cash at Bank"
           For total:  "1000.10  —  Cash at Bank   Account Total:" -->
      <textField isStretchWithOverflow="true">
        <reportElement style="acctLabel" x="4" y="2" width="370" height="12">
          <printWhenExpression><![CDATA[!"data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{acctMain} + ("0".equals($F{acctSub}) ? "" : "." + $F{acctSub}) + "  —  " + $F{description} + ("total".equals($F{rowType}) ? "   Account Total:" : "")]]></textFieldExpression>
      </textField>

      <!-- Date (data rows only) -->
      <textField pattern="dd-MM-yyyy" isStretchWithOverflow="true">
        <reportElement x="4" y="2" width="60" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{jnlDate}]]></textFieldExpression>
      </textField>

      <!-- Source (data rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="68" y="2" width="54" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{source}]]></textFieldExpression>
      </textField>

      <!-- Journal (data rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="126" y="2" width="70" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{journal}]]></textFieldExpression>
      </textField>

      <!-- Reference (data rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="200" y="2" width="100" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression>
      </textField>

      <!-- Analysis (data rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="304" y="2" width="70" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{analysisCode}]]></textFieldExpression>
      </textField>

      <!-- Debit — data and total rows -->
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true">
        <reportElement style="acctNum" x="378" y="2" width="116" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{debit}]]></textFieldExpression>
      </textField>

      <!-- Credit — data and total rows -->
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true">
        <reportElement style="acctNum" x="498" y="2" width="116" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{credit}]]></textFieldExpression>
      </textField>

      <!-- Balance — data and total rows -->
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true">
        <reportElement style="acctNum" x="618" y="2" width="116" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression>
      </textField>

      <!-- User (data rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="738" y="2" width="40" height="12">
          <printWhenExpression><![CDATA["data".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="7"/></textElement>
        <textFieldExpression><![CDATA[$F{user}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd-MM-yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <rectangle><reportElement x="0" y="2" width="782" height="26" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="262" y="8" width="112" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Total Debit / Credit:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="378" y="8" width="116" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_DEBIT}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="498" y="8" width="116" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_CREDIT}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
