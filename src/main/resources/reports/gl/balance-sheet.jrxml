<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="balance-sheet"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="AS_AT_DESC"     class="java.lang.String" isForPrompting="false"/>
  <parameter name="ACCT_RANGE"     class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUM_ASSETS"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_LIAB"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_EQUITY"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="NET_ASSETS"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"   class="java.lang.Integer"    isForPrompting="false"/>

  <field name="section"     class="java.lang.String"/>
  <field name="acctMain"    class="java.lang.String"/>
  <field name="acctSub"     class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="balance"     class="java.math.BigDecimal"/>

  <variable name="SECTION_TOTAL" class="java.math.BigDecimal"
            resetType="Group" resetGroup="SectionGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{balance}]]></variableExpression>
    <initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression>
  </variable>

  <group name="SectionGroup">
    <groupExpression><![CDATA[$F{section}]]></groupExpression>
    <groupHeader>
      <band height="22">
        <rectangle><reportElement x="0" y="4" width="782" height="16" backcolor="#506680"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField><reportElement x="4" y="6" width="500" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#506680"/><textElement><font size="9" isBold="true"/></textElement>
          <textFieldExpression><![CDATA[$F{section}.substring(2).toUpperCase()]]></textFieldExpression>
        </textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="20">
        <rectangle><reportElement x="0" y="2" width="782" height="16" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField><reportElement x="4" y="6" width="400" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement>
          <textFieldExpression><![CDATA["Total " + $F{section}.substring(2)]]></textFieldExpression>
        </textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="6" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SECTION_TOTAL}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="40">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Balance Sheet]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{AS_AT_DESC}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="52"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Account]]></text></staticText>
      <staticText><reportElement x="58"  y="4" width="26"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sub]]></text></staticText>
      <staticText><reportElement x="88"  y="4" width="468" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="562" y="4" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Balance]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4"   y="1" width="52"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctMain}]]></textFieldExpression></textField>
      <textField><reportElement x="58"  y="1" width="26"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{acctSub}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="88" y="1" width="468" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="1" width="216" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="80">
      <rectangle><reportElement x="0" y="0" width="782" height="80" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Assets:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="8" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_ASSETS}]]></textFieldExpression></textField>
      <staticText><reportElement x="4" y="24" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Liabilities:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="24" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_LIAB}]]></textFieldExpression></textField>
      <staticText><reportElement x="4" y="40" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Equity:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="40" width="216" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_EQUITY}]]></textFieldExpression></textField>
      <line><reportElement x="0" y="56" width="782" height="1" forecolor="#8aabbf"/><graphicElement><pen lineWidth="0.5"/></graphicElement></line>
      <staticText><reportElement x="4" y="60" width="300" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="10" isBold="true"/></textElement><text><![CDATA[Net Assets (Assets − Liabilities):]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="562" y="60" width="216" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{NET_ASSETS}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
