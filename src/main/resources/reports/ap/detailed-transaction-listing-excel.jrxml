<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="detailed-transaction-listing-excel"
              pageWidth="2440" pageHeight="595" orientation="Landscape"
              columnWidth="2400" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="DATE_BASIS_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="GRAND_AMT" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_TAX" class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="suppNo"      class="java.lang.String"/>
  <field name="name"        class="java.lang.String"/>
  <field name="subLedger"   class="java.lang.String"/>
  <field name="subLedgerName" class="java.lang.String"/>
  <field name="docType"     class="java.lang.String"/>
  <field name="retentFlag"  class="java.lang.String"/>
  <field name="docDate"     class="java.sql.Date"/>
  <field name="docNo"       class="java.lang.String"/>
  <field name="postDate"    class="java.sql.Date"/>
  <field name="dueDate"     class="java.sql.Date"/>
  <field name="poNo"        class="java.lang.String"/>
  <field name="transRef"    class="java.lang.String"/>
  <field name="abn"         class="java.lang.String"/>
  <field name="batchNo"     class="java.lang.Integer"/>
  <field name="mustPay"     class="java.lang.String"/>
  <field name="promptPay"   class="java.lang.String"/>
  <field name="transAmt"    class="java.math.BigDecimal"/>
  <field name="retentAmt"   class="java.math.BigDecimal"/>
  <field name="lineNo"      class="java.lang.Integer"/>
  <field name="lineType"    class="java.lang.String"/>
  <field name="glAcct"      class="java.lang.String"/>
  <field name="glDesc"      class="java.lang.String"/>
  <field name="desc1"       class="java.lang.String"/>
  <field name="qty"         class="java.math.BigDecimal"/>
  <field name="unitPer"     class="java.lang.String"/>
  <field name="unitCost"    class="java.math.BigDecimal"/>
  <field name="lineAmt"     class="java.math.BigDecimal"/>
  <field name="taxCode"     class="java.lang.String"/>
  <field name="lineTaxAmt"  class="java.math.BigDecimal"/>
  <field name="amtPaid"     class="java.math.BigDecimal"/>
  <field name="analysisCode" class="java.lang.String"/>
  <field name="ledgerType"  class="java.lang.String"/>
  <field name="ledgerCode"  class="java.lang.String"/>

  <title>
    <band height="22">
      <textField><reportElement x="0" y="0" width="900" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Detailed Transaction Listing — " + $P{COMPANY_NAME} + "  (" + $P{DATE_BASIS_DESC} + ")"]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="16">
      <staticText><reportElement x="0"    y="0" width="60"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Supplier No]]></text></staticText>
      <staticText><reportElement x="60"   y="0" width="150" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Supplier Name]]></text></staticText>
