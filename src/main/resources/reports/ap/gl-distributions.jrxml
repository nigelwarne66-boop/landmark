<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="gl-distributions"
              pageWidth="595" pageHeight="842" orientation="Portrait"
              columnWidth="535" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="PERIOD_END"      class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUB_LEDGER_DESC" class="java.lang.String" isForPrompting="false"/>
  <parameter name="GT_CONTROL" class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GT_EXPENSE" class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="subLedger"   class="java.lang.String"/>
  <field name="acctType"    class="java.lang.String"/>
  <field name="acctTypeRaw" class="java.lang.String"/>
  <field name="glAcct"      class="java.lang.String"/>
  <field name="glDesc"      class="java.lang.String"/>
  <field name="amount"      class="java.math.BigDecimal"/>

  <variable name="SEC_COUNT" class="java.lang.Integer"    calculation="Count" resetType="Group" resetGroup="typeGroup"><variableExpression><![CDATA[$F{glAcct}]]></variableExpression></variable>
  <variable name="SEC_TOTAL" class="java.math.BigDecimal" calculation="Sum"   resetType="Group" resetGroup="typeGroup"><variableExpression><![CDATA[$F{amount}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

  <group name="typeGroup">
    <groupExpression><![CDATA[$F{acctTypeRaw}]]></groupExpression>
    <groupHeader>
      <band height="20">
        <textField><reportElement x="0" y="4" width="400" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($F{acctType}==null?"":$F{acctType}) + " ACCOUNTS"]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="16">
        <line><reportElement x="0" y="1" width="535" height="1" forecolor="#888888"/></line>
        <textField><reportElement x="0" y="2" width="200" height="12"/><textElement><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SEC_COUNT} + " account(s) total"]]></textFieldExpression></textField>
        <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="420" y="2" width="115" height="12"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SEC_TOTAL}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <title>
    <band height="54">
      <staticText><reportElement x="0" y="0" width="500" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[GL Distributions Summary]]></text></staticText>
      <textField><reportElement x="0" y="20" width="400" height="13"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="36" width="500" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA["Period ending " + $P{PERIOD_END} + "  •  " + $P{SUB_LEDGER_DESC}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <rectangle><reportElement x="0" y="0" width="535" height="18" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="3" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[SubLgr]]></text></staticText>
      <staticText><reportElement x="60"  y="3" width="90"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[GL Account]]></text></staticText>
      <staticText><reportElement x="155" y="3" width="260" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="420" y="3" width="115" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4" y="1" width="50" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField><reportElement x="60" y="1" width="90" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glAcct}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="155" y="1" width="260" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{glDesc}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="420" y="1" width="115" height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="420" y="2" width="115" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="44">
      <line><reportElement x="0" y="4" width="535" height="1" forecolor="#1e2d45"/><graphicElement><pen lineWidth="1"/></graphicElement></line>
      <staticText><reportElement x="0" y="8"  width="300" height="12"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Control Accounts:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="420" y="8" width="115" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GT_CONTROL}]]></textFieldExpression></textField>
      <staticText><reportElement x="0" y="24" width="300" height="12"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total Distribution Accounts:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="420" y="24" width="115" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GT_EXPENSE}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
