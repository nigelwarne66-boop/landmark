<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="creditors-ageing-excel"
              pageWidth="1140" pageHeight="595" orientation="Landscape"
              columnWidth="1100" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="AS_AT_DATE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATE_BASIS"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="AMT_BASIS"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATES_TYPE_DESC" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_1" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_2" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_3" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_4" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_5" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_6" class="java.lang.String" isForPrompting="false"/>

  <field name="suppNo"        class="java.lang.String"/>
  <field name="name"          class="java.lang.String"/>
  <field name="subLedger"     class="java.lang.String"/>
  <field name="subLedgerName" class="java.lang.String"/>
  <field name="location"      class="java.lang.String"/>
  <field name="phone"         class="java.lang.String"/>
  <field name="p1"            class="java.math.BigDecimal"/>
  <field name="p2"            class="java.math.BigDecimal"/>
  <field name="p3"            class="java.math.BigDecimal"/>
  <field name="p4"            class="java.math.BigDecimal"/>
  <field name="p5"            class="java.math.BigDecimal"/>
  <field name="p6"            class="java.math.BigDecimal"/>
  <field name="total"         class="java.math.BigDecimal"/>

  <variable name="SUM_P1"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p1}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_P2"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p2}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_P3"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p3}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_P4"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p4}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_P5"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p5}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_P6"    class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{p6}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_TOTAL" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{total}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="ROW_COUNT" class="java.lang.Integer"    calculation="Count"><variableExpression><![CDATA[$F{suppNo}]]></variableExpression></variable>

  <title>
    <band height="22">
      <textField><reportElement x="0" y="0" width="1000" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Creditors Ageing — " + $P{COMPANY_NAME} + "  (" + $P{DATES_TYPE_DESC} + ", " + $P{DATE_BASIS} + ", " + $P{AMT_BASIS} + ", as at " + $P{AS_AT_DATE} + ")"]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="16">
      <staticText><reportElement x="0"   y="0" width="60"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Supplier No]]></text></staticText>
      <staticText><reportElement x="60"  y="0" width="150" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Supplier Name]]></text></staticText>
      <staticText><reportElement x="210" y="0" width="50"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger]]></text></staticText>
      <staticText><reportElement x="260" y="0" width="120" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sub Ledger Name]]></text></staticText>
      <staticText><reportElement x="380" y="0" width="110" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Location]]></text></staticText>
      <staticText><reportElement x="490" y="0" width="80"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Phone]]></text></staticText>
      <textField><reportElement x="570" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_1}]]></textFieldExpression></textField>
      <textField><reportElement x="644" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_2}]]></textFieldExpression></textField>
      <textField><reportElement x="718" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_3}]]></textFieldExpression></textField>
      <textField><reportElement x="792" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_4}]]></textFieldExpression></textField>
      <textField><reportElement x="866" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_5}]]></textFieldExpression></textField>
      <textField><reportElement x="940" y="0" width="74"  height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_6}]]></textFieldExpression></textField>
      <staticText><reportElement x="1014" y="0" width="86" height="16" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Total]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{suppNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="60" y="0" width="150" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{name}]]></textFieldExpression></textField>
      <textField><reportElement x="210" y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedger}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="260" y="0" width="120" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{subLedgerName}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="380" y="0" width="110" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{location}]]></textFieldExpression></textField>
      <textField><reportElement x="490" y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{phone}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="570" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p1}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="644" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p2}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="718" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p3}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="792" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p4}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="866" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p5}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="940" y="0" width="74" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{p6}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1014" y="0" width="86" height="14"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{total}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="22">
      <textField><reportElement x="0" y="4" width="260" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{ROW_COUNT} + " supplier(s) — total outstanding:"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="570" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P1}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="644" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P2}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="718" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P3}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="792" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P4}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="866" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P5}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="940" y="4" width="74" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_P6}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1014" y="4" width="86" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
