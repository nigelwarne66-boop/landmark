<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="creditors-ageing-detail"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <!-- Row-kind styles: header = supplier band, subtotal = supplier total band -->
  <style name="rowLabel" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["subtotal".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#e2ecf6" forecolor="#1e2d45" isBold="true"/>
    </conditionalStyle>
  </style>
  <style name="rowNum" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#506680"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["subtotal".equals($F{rowType})]]></conditionExpression>
      <style mode="Opaque" backcolor="#e2ecf6" forecolor="#1e2d45" isBold="true"/>
    </conditionalStyle>
  </style>

  <parameter name="COMPANY_NO"   class="java.lang.Integer"/>
  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="AS_AT_DATE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATE_BASIS"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="AMT_BASIS"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_1" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_2" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_3" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_4" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_5" class="java.lang.String" isForPrompting="false"/>
  <parameter name="PERIOD_6" class="java.lang.String" isForPrompting="false"/>
  <parameter name="SUPP_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="GRAND_P1"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_P2"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_P3"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_P4"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_P5"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_P6"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="GRAND_BALANCE" class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="rowType"  class="java.lang.String"/>
  <field name="suppNo"   class="java.lang.String"/>
  <field name="name"     class="java.lang.String"/>
  <field name="docDate"  class="java.lang.String"/>
  <field name="docType"  class="java.lang.String"/>
  <field name="docNo"    class="java.lang.String"/>
  <field name="status"   class="java.lang.String"/>
  <field name="p1"       class="java.math.BigDecimal"/>
  <field name="p2"       class="java.math.BigDecimal"/>
  <field name="p3"       class="java.math.BigDecimal"/>
  <field name="p4"       class="java.math.BigDecimal"/>
  <field name="p5"       class="java.math.BigDecimal"/>
  <field name="p6"       class="java.math.BigDecimal"/>
  <field name="balance"  class="java.math.BigDecimal"/>

  <title>
    <band height="56">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Creditors Ageing — Detail]]></text></staticText>
      <textField><reportElement x="0" y="22" width="500" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="500" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA["By " + $P{DATE_BASIS} + " — " + $P{AMT_BASIS}]]></textFieldExpression></textField>
      <staticText><reportElement x="600" y="22" width="80"  height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><text><![CDATA[As at:]]></text></staticText>
      <textField><reportElement x="682" y="22" width="100" height="12"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{AS_AT_DATE}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy HH:mm"><reportElement x="600" y="38" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="158" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
      <staticText><reportElement x="220" y="4" width="38"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="260" y="4" width="55"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Doc No]]></text></staticText>
      <staticText><reportElement x="317" y="4" width="55"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
      <textField><reportElement x="374" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_1}]]></textFieldExpression></textField>
      <textField><reportElement x="434" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_2}]]></textFieldExpression></textField>
      <textField><reportElement x="494" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_3}]]></textFieldExpression></textField>
      <textField><reportElement x="554" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_4}]]></textFieldExpression></textField>
      <textField><reportElement x="614" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_5}]]></textFieldExpression></textField>
      <textField><reportElement x="674" y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{PERIOD_6}]]></textFieldExpression></textField>
      <staticText><reportElement x="726" y="4" width="56"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Balance]]></text></staticText>
    </band>
  </columnHeader>

  <!-- Single detail band — injected-rows pattern (header / txn / subtotal).
       Background rectangles use element-level printWhenExpression; all textFields
       carry isStretchWithOverflow="true" to dodge the Jasper 6.21 stretch bug. -->
  <detail>
    <band height="14">
      <!-- Backgrounds -->
      <rectangle>
        <reportElement x="0" y="0" width="782" height="14" backcolor="#506680" forecolor="#506680">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>
      <rectangle>
        <reportElement x="0" y="0" width="782" height="14" backcolor="#e2ecf6" forecolor="#e2ecf6">
          <printWhenExpression><![CDATA["subtotal".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <graphicElement><pen lineWidth="0"/></graphicElement>
      </rectangle>

      <!-- Supplier header: "1234 — Supplier Name" (header rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement style="rowLabel" x="4" y="1" width="370" height="12">
          <printWhenExpression><![CDATA["header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{suppNo} + "   —   " + $F{name}]]></textFieldExpression>
      </textField>

      <!-- Subtotal label (subtotal rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement style="rowLabel" x="4" y="1" width="370" height="12">
          <printWhenExpression><![CDATA["subtotal".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA["Total for " + $F{suppNo} + " :"]]></textFieldExpression>
      </textField>

      <!-- Transaction columns (txn rows only) -->
      <textField isStretchWithOverflow="true">
        <reportElement x="158" y="1" width="60" height="12">
          <printWhenExpression><![CDATA["txn".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true">
        <reportElement x="220" y="1" width="38" height="12">
          <printWhenExpression><![CDATA["txn".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true">
        <reportElement x="260" y="1" width="55" height="12">
          <printWhenExpression><![CDATA["txn".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression>
      </textField>
      <textField isStretchWithOverflow="true">
        <reportElement x="317" y="1" width="55" height="12">
          <printWhenExpression><![CDATA["txn".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{status}]]></textFieldExpression>
      </textField>

      <!-- Ageing buckets — show for txn and subtotal rows (zero suppressed) -->
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="374" y="1" width="58" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p1}.signum()==0 ? null : $F{p1}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="434" y="1" width="58" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p2}.signum()==0 ? null : $F{p2}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="494" y="1" width="58" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p3}.signum()==0 ? null : $F{p3}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="554" y="1" width="58" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p4}.signum()==0 ? null : $F{p4}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="614" y="1" width="58" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p5}.signum()==0 ? null : $F{p5}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true" isBlankWhenNull="true">
        <reportElement style="rowNum" x="674" y="1" width="50" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8"/></textElement>
        <textFieldExpression><![CDATA[$F{p6}.signum()==0 ? null : $F{p6}]]></textFieldExpression>
      </textField>
      <textField pattern="#,##0.00;(#,##0.00)" isStretchWithOverflow="true">
        <reportElement style="rowNum" x="726" y="1" width="56" height="12">
          <printWhenExpression><![CDATA[!"header".equals($F{rowType})]]></printWhenExpression>
        </reportElement>
        <textElement textAlignment="Right"><font size="8" isBold="true"/></textElement>
        <textFieldExpression><![CDATA[$F{balance}]]></textFieldExpression>
      </textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd-MM-yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <rectangle><reportElement x="0" y="0" width="782" height="30" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="4" y="6" width="200" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{SUPP_COUNT}==null?0:$P{SUPP_COUNT}) + " supplier(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="220" y="6" width="150" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><text><![CDATA[Total outstanding:]]></text></staticText>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="374" y="6" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P1}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="434" y="6" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P2}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="494" y="6" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P3}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="554" y="6" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P4}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="614" y="6" width="58" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P5}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="674" y="6" width="50" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_P6}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="726" y="6" width="56" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_BALANCE}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
