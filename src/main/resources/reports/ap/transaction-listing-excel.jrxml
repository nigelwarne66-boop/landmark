<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="transaction-listing-excel"
              pageWidth="3000" pageHeight="595" orientation="Landscape"
              columnWidth="2960" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="pageHeader"/>

  <!-- Blank (not the literal "null") for any null field value. -->
  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"    class="java.lang.String"/>
  <parameter name="DATE_BASIS_DESC" class="java.lang.String"  isForPrompting="false"/>
  <parameter name="GRAND_NO"        class="java.lang.Integer"    isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"     class="java.math.BigDecimal" isForPrompting="false"/>

  <field name="rowType"     class="java.lang.String"/>
  <field name="suppNo"      class="java.lang.String"/>
  <field name="name"        class="java.lang.String"/>
  <field name="subLedger"   class="java.lang.String"/>
  <field name="subLedgerName" class="java.lang.String"/>
  <field name="docDate"     class="java.sql.Date"/>
  <field name="postDate"    class="java.sql.Date"/>
  <field name="auditDate"   class="java.sql.Date"/>
  <field name="docType"     class="java.lang.String"/>
  <field name="retentFlag"  class="java.lang.String"/>
  <field name="docNo"       class="java.lang.String"/>
  <field name="seqNo"       class="java.lang.String"/>
  <field name="amt"         class="java.math.BigDecimal"/>
  <field name="retentAmt"   class="java.math.BigDecimal"/>
  <field name="debit"       class="java.math.BigDecimal"/>
  <field name="credit"      class="java.math.BigDecimal"/>
  <field name="amtPaid"     class="java.math.BigDecimal"/>
  <field name="discTaken"   class="java.math.BigDecimal"/>
  <field name="balance"     class="java.math.BigDecimal"/>
  <field name="taxAmt"      class="java.math.BigDecimal"/>
  <field name="paidFlag"    class="java.lang.String"/>
  <field name="paidDocDate" class="java.sql.Date"/>
  <field name="paidPostDate" class="java.sql.Date"/>
  <field name="batchNo"     class="java.lang.Integer"/>
  <field name="reconNo"     class="java.lang.Integer"/>
  <field name="archiveFlag" class="java.lang.String"/>
  <field name="auditUser"   class="java.lang.String"/>
  <field name="auditTime"   class="java.lang.String"/>
  <field name="poNo"        class="java.lang.String"/>
  <field name="lineNo"      class="java.lang.Integer"/>
  <field name="lineType"    class="java.lang.String"/>
  <field name="glAcctMain"  class="java.lang.Integer"/>
  <field name="glAcctSub"   class="java.lang.Integer"/>
  <field name="qty"         class="java.math.BigDecimal"/>
  <field name="unitPer"     class="java.lang.String"/>
  <field name="unitCost"    class="java.math.BigDecimal"/>
  <field name="amtExTax"    class="java.math.BigDecimal"/>
  <field name="taxCode"     class="java.lang.String"/>
  <field name="lineTaxAmt"  class="java.math.BigDecimal"/>
  <field name="amtIncTax"   class="java.math.BigDecimal"/>
  <field name="fcAmt"       class="java.math.BigDecimal"/>
  <field name="description" class="java.lang.String"/>
  <field name="reference"   class="java.lang.String"/>

  <title>
    <band height="22">
      <textField><reportElement x="0" y="0" width="900" height="16"/><textElement><font size="11" isBold="true"/></textElement><textFieldExpression><![CDATA["Transaction Listing — " + $P{COMPANY_NAME} + "  (" + $P{DATE_BASIS_DESC} + ")"]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="16">
