<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="sales-history"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"  class="java.lang.String"/>
  <parameter name="LOC_DESC"      class="java.lang.String"     isForPrompting="false"/>
  <parameter name="ITEM_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="CUST_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_SALES"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_COST"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"     class="java.lang.Integer"    isForPrompting="false"/>

  <field name="stockCode"    class="java.lang.String"/>
  <field name="description"  class="java.lang.String"/>
  <field name="customerNo"   class="java.lang.String"/>
  <field name="customerName" class="java.lang.String"/>
  <field name="qty"          class="java.math.BigDecimal"/>
  <field name="salesValue"   class="java.math.BigDecimal"/>
  <field name="costValue"    class="java.math.BigDecimal"/>
  <field name="margin"       class="java.math.BigDecimal"/>
  <field name="lineCount"    class="java.lang.Integer"/>

  <title>
    <band height="58">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Sales History]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{LOC_DESC}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$P{ITEM_RANGE} + "  •  " + $P{CUST_RANGE} + "  •  " + $P{DATE_RANGE}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="70"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Stock Code]]></text></staticText>
      <staticText><reportElement x="74"  y="4" width="160" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="234" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Cust No]]></text></staticText>
      <staticText><reportElement x="294" y="4" width="150" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Customer Name]]></text></staticText>
      <staticText><reportElement x="444" y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Lines]]></text></staticText>
      <staticText><reportElement x="494" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Qty]]></text></staticText>
      <staticText><reportElement x="554" y="4" width="76"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Sales Value]]></text></staticText>
      <staticText><reportElement x="630" y="4" width="76"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Cost Value]]></text></staticText>
      <staticText><reportElement x="706" y="4" width="76"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Margin]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4"   y="1" width="70"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{stockCode}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="74"  y="1" width="160" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField><reportElement x="234" y="1" width="60"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{customerNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="294" y="1" width="150" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{customerName}]]></textFieldExpression></textField>
      <textField pattern="#0"><reportElement x="444" y="1" width="50"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lineCount}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="494" y="1" width="60"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="554" y="1" width="76"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{salesValue}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="630" y="1" width="76"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{costValue}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="706" y="1" width="76"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{margin}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <rectangle><reportElement x="0" y="0" width="782" height="30" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " line(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="420" y="8" width="134" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Total sales / cost:]]></text></staticText>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="554" y="8" width="76" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_SALES}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="630" y="8" width="76" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_COST}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
