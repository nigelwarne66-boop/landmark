<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="inventory-movements-detail-excel"
              pageWidth="1600" pageHeight="595" orientation="Landscape"
              columnWidth="1560" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"  class="java.lang.String"/>
  <parameter name="LOC_DESC"      class="java.lang.String"     isForPrompting="false"/>
  <parameter name="ITEM_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="PTYPE_RANGE"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="KIND_DESC"     class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_COST"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="SUM_SALE"      class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"     class="java.lang.Integer"    isForPrompting="false"/>

  <field name="locNo"       class="java.lang.String"/>
  <field name="stockCode"   class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="moveDate"    class="java.sql.Date"/>
  <field name="kind"        class="java.lang.String"/>
  <field name="inOut"       class="java.lang.String"/>
  <field name="docType"     class="java.lang.String"/>
  <field name="docNo"       class="java.lang.String"/>
  <field name="ref"         class="java.lang.String"/>
  <field name="partyNo"     class="java.lang.String"/>
  <field name="qty"         class="java.math.BigDecimal"/>
  <field name="unitCost"    class="java.math.BigDecimal"/>
  <field name="costValue"   class="java.math.BigDecimal"/>
  <field name="unitPrice"   class="java.math.BigDecimal"/>
  <field name="saleValue"   class="java.math.BigDecimal"/>

  <variable name="SUM_C" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{costValue}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>
  <variable name="SUM_S" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{saleValue}]]></variableExpression><initialValueExpression><![CDATA[java.math.BigDecimal.ZERO]]></initialValueExpression></variable>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="800" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Inventory Movements Detail]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1560" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{LOC_DESC} + "   •   " + $P{KIND_DESC} + "   •   " + $P{ITEM_RANGE} + "   •   " + $P{PTYPE_RANGE} + "   •   " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="50"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Location]]></text></staticText>
      <staticText><reportElement x="50"   y="0" width="110" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Stock Code]]></text></staticText>
      <staticText><reportElement x="160"  y="0" width="220" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="380"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Movement Date]]></text></staticText>
      <staticText><reportElement x="460"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Movement Kind]]></text></staticText>
      <staticText><reportElement x="540"  y="0" width="50"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[In / Out]]></text></staticText>
      <staticText><reportElement x="590"  y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Doc Type]]></text></staticText>
      <staticText><reportElement x="650"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document No]]></text></staticText>
      <staticText><reportElement x="730"  y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="830"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Party No]]></text></staticText>
      <staticText><reportElement x="910"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Quantity]]></text></staticText>
      <staticText><reportElement x="990"  y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unit Cost]]></text></staticText>
      <staticText><reportElement x="1080" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Cost Value]]></text></staticText>
      <staticText><reportElement x="1180" y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Unit Price]]></text></staticText>
      <staticText><reportElement x="1270" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Sale Value]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"    y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{locNo}]]></textFieldExpression></textField>
      <textField><reportElement x="50"   y="0" width="110" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{stockCode}]]></textFieldExpression></textField>
      <textField><reportElement x="160"  y="0" width="220" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="380"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{moveDate}]]></textFieldExpression></textField>
      <textField><reportElement x="460"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{kind}]]></textFieldExpression></textField>
      <textField><reportElement x="540"  y="0" width="50"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{inOut}]]></textFieldExpression></textField>
      <textField><reportElement x="590"  y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField><reportElement x="650"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField><reportElement x="730"  y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ref}]]></textFieldExpression></textField>
      <textField><reportElement x="830"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{partyNo}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="910"  y="0" width="80"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="990"  y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{unitCost}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1080" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{costValue}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="1180" y="0" width="90"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{unitPrice}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1270" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{saleValue}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="600" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " movement(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1080" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_C}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="1270" y="3" width="100" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{SUM_S}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
