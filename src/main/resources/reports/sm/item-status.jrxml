<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="item-status"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME"  class="java.lang.String"/>
  <parameter name="SEQUENCE_DESC" class="java.lang.String"     isForPrompting="false"/>
  <parameter name="LOC_DESC"      class="java.lang.String"     isForPrompting="false"/>
  <parameter name="ITEM_RANGE"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="PTYPE_RANGE"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="REPORT_DATE"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_VALUE"     class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"     class="java.lang.Integer"    isForPrompting="false"/>

  <field name="locNo"        class="java.lang.String"/>
  <field name="stockCode"    class="java.lang.String"/>
  <field name="description"  class="java.lang.String"/>
  <field name="productType"  class="java.lang.String"/>
  <field name="itemStatus"   class="java.lang.String"/>
  <field name="qtyOnHand"    class="java.math.BigDecimal"/>
  <field name="qtyAllocated" class="java.math.BigDecimal"/>
  <field name="qtyOnOrder"   class="java.math.BigDecimal"/>
  <field name="stdCost"      class="java.math.BigDecimal"/>
  <field name="valueOnHand"  class="java.math.BigDecimal"/>
  <field name="lastSaleDate" class="java.sql.Date"/>
  <field name="lastMoveDate" class="java.sql.Date"/>

  <title>
    <band height="54">
      <staticText><reportElement x="0" y="0" width="500" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Item Status]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  by " + $P{SEQUENCE_DESC}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$P{LOC_DESC} + "  •  " + $P{ITEM_RANGE} + "  •  " + $P{PTYPE_RANGE} + "  •  As at " + $P{REPORT_DATE}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="30"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Loc]]></text></staticText>
      <staticText><reportElement x="34"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Stock Code]]></text></staticText>
      <staticText><reportElement x="114" y="4" width="170" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="284" y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="334" y="4" width="36"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Sts]]></text></staticText>
      <staticText><reportElement x="370" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[On Hand]]></text></staticText>
      <staticText><reportElement x="430" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Allocated]]></text></staticText>
      <staticText><reportElement x="490" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[On Order]]></text></staticText>
      <staticText><reportElement x="550" y="4" width="60"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Std Cost]]></text></staticText>
      <staticText><reportElement x="610" y="4" width="68"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Value On Hand]]></text></staticText>
      <staticText><reportElement x="678" y="4" width="52"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Last Sale]]></text></staticText>
      <staticText><reportElement x="730" y="4" width="52"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Last Move]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="13">
      <textField><reportElement x="4"   y="1" width="30"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{locNo}]]></textFieldExpression></textField>
      <textField><reportElement x="34"  y="1" width="80"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{stockCode}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="114" y="1" width="170" height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField><reportElement x="284" y="1" width="50"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{productType}]]></textFieldExpression></textField>
      <textField><reportElement x="334" y="1" width="36"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{itemStatus}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="370" y="1" width="60"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qtyOnHand}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="430" y="1" width="60"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qtyAllocated}]]></textFieldExpression></textField>
      <textField pattern="#,##0.000"><reportElement x="490" y="1" width="60"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qtyOnOrder}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="550" y="1" width="60"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{stdCost}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="610" y="1" width="68"  height="11"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{valueOnHand}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy"><reportElement x="678" y="1" width="52"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lastSaleDate}]]></textFieldExpression></textField>
      <textField pattern="dd-MM-yyyy"><reportElement x="730" y="1" width="52"  height="11"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lastMoveDate}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd-MM-yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="30">
      <rectangle><reportElement x="0" y="0" width="782" height="30" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " item(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="500" y="8" width="110" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Total value on hand:]]></text></staticText>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="610" y="8" width="68" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_VALUE}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
