<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="business-activity-statement-excel"
              pageWidth="760" pageHeight="595" orientation="Landscape"
              columnWidth="760" leftMargin="0" rightMargin="0"
              topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="ENTITY_NAME"  class="java.lang.String"  isForPrompting="false"/>
  <parameter name="ABN"          class="java.lang.String"  isForPrompting="false"/>
  <parameter name="BAS_DESC"     class="java.lang.String"  isForPrompting="false"/>
  <parameter name="PERIOD"       class="java.lang.String"  isForPrompting="false"/>
  <parameter name="DUE_DATE"     class="java.lang.String"  isForPrompting="false"/>
  <parameter name="PAY_DATE"     class="java.lang.String"  isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer" isForPrompting="false"/>

  <field name="section"     class="java.lang.String"/>
  <field name="label"       class="java.lang.String"/>
  <field name="description" class="java.lang.String"/>
  <field name="amount"      class="java.math.BigDecimal"/>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="760" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Business Activity Statement]]></text></staticText>
      <textField><reportElement x="0" y="20" width="760" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{ENTITY_NAME} + "  —  ABN: " + ($P{ABN}==null?"":$P{ABN}) + "  —  " + ($P{PERIOD}==null?"":$P{PERIOD}) + "  —  Due: " + ($P{DUE_DATE}==null?"":$P{DUE_DATE})]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="130" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Section]]></text></staticText>
      <staticText><reportElement x="130" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Label]]></text></staticText>
      <staticText><reportElement x="190" y="0" width="430" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="620" y="0" width="140" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="130" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{section}]]></textFieldExpression></textField>
      <textField><reportElement x="130" y="0" width="60"  height="14"/><textElement><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{label}]]></textFieldExpression></textField>
      <textField><reportElement x="190" y="0" width="430" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{description}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="620" y="0" width="140" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="620" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " line(s)  —  BAS: " + ($P{BAS_DESC}==null?"":$P{BAS_DESC})]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
