<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="detailed-bas-excel"
              pageWidth="1100" pageHeight="595" orientation="Landscape"
              columnWidth="1060" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="BAS_DESC"     class="java.lang.String"      isForPrompting="false"/>
  <parameter name="MODE_DESC"    class="java.lang.String"      isForPrompting="false"/>
  <parameter name="SUM_GROSS"    class="java.math.BigDecimal"  isForPrompting="false"/>
  <parameter name="SUM_TAX"      class="java.math.BigDecimal"  isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"     isForPrompting="false"/>

  <field name="basCode"     class="java.lang.String"/>
  <field name="codeDesc"    class="java.lang.String"/>
  <field name="count"       class="java.lang.Integer"/>
  <field name="grossAmt"    class="java.math.BigDecimal"/>
  <field name="taxAmt"      class="java.math.BigDecimal"/>
  <field name="trxDate"     class="java.sql.Date"/>
  <field name="postingDate" class="java.sql.Date"/>
  <field name="gstCode"     class="java.lang.String"/>
  <field name="party"       class="java.lang.String"/>
  <field name="reference"   class="java.lang.String"/>

  <title>
    <band height="34">
      <staticText><reportElement x="0" y="0" width="1060" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Detailed BAS]]></text></staticText>
      <textField><reportElement x="0" y="20" width="1060" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   BAS: " + ($P{BAS_DESC}==null?"":$P{BAS_DESC}) + "   —   " + ($P{MODE_DESC}==null?"":$P{MODE_DESC})]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[BAS Code]]></text></staticText>
      <staticText><reportElement x="70"  y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Code Description]]></text></staticText>
      <staticText><reportElement x="270" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Date]]></text></staticText>
      <staticText><reportElement x="350" y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Posting Date]]></text></staticText>
      <staticText><reportElement x="430" y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[GST Code]]></text></staticText>
      <staticText><reportElement x="490" y="0" width="200" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Party]]></text></staticText>
      <staticText><reportElement x="690" y="0" width="130" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="820" y="0" width="50"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Count]]></text></staticText>
      <staticText><reportElement x="870" y="0" width="95"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Gross Amount]]></text></staticText>
      <staticText><reportElement x="965" y="0" width="95"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Tax Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField><reportElement x="0"   y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{basCode}]]></textFieldExpression></textField>
      <textField><reportElement x="70"  y="0" width="200" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codeDesc}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="270" y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{trxDate}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="350" y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{postingDate}]]></textFieldExpression></textField>
      <textField><reportElement x="430" y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{gstCode}]]></textFieldExpression></textField>
      <textField><reportElement x="490" y="0" width="200" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{party}]]></textFieldExpression></textField>
      <textField><reportElement x="690" y="0" width="130" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{reference}]]></textFieldExpression></textField>
      <textField><reportElement x="820" y="0" width="50"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{count}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="870" y="0" width="95"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{grossAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="965" y="0" width="95"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{taxAmt}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="870" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " row(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="870" y="3" width="95" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_GROSS}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="965" y="3" width="95" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_TAX}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
