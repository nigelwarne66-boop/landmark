<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="extended-super"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATE_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="payCode"        class="java.lang.String"/>
  <field name="codeDesc"       class="java.lang.String"/>
  <field name="fundName"       class="java.lang.String"/>
  <field name="fundAbn"        class="java.lang.String"/>
  <field name="empNo"          class="java.lang.Integer"/>
  <field name="surname"        class="java.lang.String"/>
  <field name="firstName"      class="java.lang.String"/>
  <field name="maskedTfn"      class="java.lang.String"/>
  <field name="payrunDate"     class="java.sql.Date"/>
  <field name="amount"         class="java.math.BigDecimal"/>
  <field name="beforeAfterTax" class="java.lang.String"/>

  <group name="codeGroup" isReprintHeaderOnEachPage="true">
    <groupExpression><![CDATA[$F{payCode}]]></groupExpression>
    <groupHeader>
      <band height="16">
        <rectangle><reportElement x="0" y="0" width="782" height="16" backcolor="#506680"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <textField isStretchWithOverflow="true"><reportElement x="4" y="2" width="600" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#506680"/><textElement><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{payCode} + "  —  " + $F{codeDesc} + (($F{fundName}!=null && !$F{fundName}.isEmpty()) ? "   Fund: " + $F{fundName} : "") + (($F{fundAbn}!=null && !$F{fundAbn}.isEmpty()) ? "  ABN: " + $F{fundAbn} : "")]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="14">
        <rectangle><reportElement x="0" y="0" width="782" height="14" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
        <staticText><reportElement x="4" y="2" width="300" height="10" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Code Total]]></text></staticText>
        <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="632" y="2" width="146" height="10" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{codeGroup_AMOUNT_sum}]]></textFieldExpression></textField>
      </band>
    </groupFooter>
  </group>

  <group name="empSubGroup">
    <groupExpression><![CDATA[$F{payCode} + "|" + $F{empNo}]]></groupExpression>
    <groupHeader>
      <band height="14">
        <textField isStretchWithOverflow="true"><reportElement x="4" y="1" width="500" height="12"/><textElement><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{empNo} + "  —  " + $F{surname} + ", " + $F{firstName} + "   TFN: " + $F{maskedTfn}]]></textFieldExpression></textField>
      </band>
    </groupHeader>
    <groupFooter>
      <band height="0"/>
    </groupFooter>
  </group>

  <variable name="codeGroup_AMOUNT_sum" class="java.math.BigDecimal" resetType="Group" resetGroup="codeGroup" calculation="Sum">
    <variableExpression><![CDATA[$F{amount}]]></variableExpression>
  </variable>

  <title>
    <band height="52">
      <staticText><reportElement x="0" y="0" width="500" height="18"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Extended Superannuation]]></text></staticText>
      <textField isStretchWithOverflow="true"><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$P{DATE_RANGE}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="70"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Payrun Date]]></text></staticText>
      <staticText><reportElement x="78"  y="4" width="40"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Bef/Aft]]></text></staticText>
      <staticText><reportElement x="122" y="4" width="510" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[]]></text></staticText>
      <staticText><reportElement x="636" y="4" width="142" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="12">
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="4"   y="1" width="70"  height="10"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{payrunDate}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="78"  y="1" width="40"  height="10"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{beforeAfterTax}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="636" y="1" width="142" height="10"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="28">
      <rectangle><reportElement x="0" y="0" width="782" height="28" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " line(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="390" y="8" width="242" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Grand Total:]]></text></staticText>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="636" y="8" width="142" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
