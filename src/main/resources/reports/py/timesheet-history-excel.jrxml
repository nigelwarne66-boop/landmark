<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="timesheet-history-excel"
              pageWidth="1600" pageHeight="595" orientation="Landscape"
              columnWidth="1600" leftMargin="0" rightMargin="0"
              topMargin="0" bottomMargin="0"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>
  <property name="net.sf.jasperreports.export.xls.white.page.background" value="false"/>
  <property name="net.sf.jasperreports.export.xls.ignore.page.margins" value="true"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false"/>
  <parameter name="DATE_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="paygroup"   class="java.lang.String"/>
  <field name="empNo"      class="java.lang.Integer"/>
  <field name="surname"    class="java.lang.String"/>
  <field name="firstName"  class="java.lang.String"/>
  <field name="dept"       class="java.lang.String"/>
  <field name="payrunNo"   class="java.lang.Integer"/>
  <field name="payrunDate" class="java.sql.Date"/>
  <field name="startDate"  class="java.sql.Date"/>
  <field name="endDate"    class="java.sql.Date"/>
  <field name="payCode"    class="java.lang.String"/>
  <field name="codeDesc"   class="java.lang.String"/>
  <field name="hours"      class="java.math.BigDecimal"/>
  <field name="qty"        class="java.math.BigDecimal"/>
  <field name="ratePerc"   class="java.math.BigDecimal"/>
  <field name="amount"     class="java.math.BigDecimal"/>
  <field name="ref"        class="java.lang.String"/>

  <title>
    <band height="30">
      <staticText><reportElement x="0" y="0" width="1600" height="16"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Timesheet History]]></text></staticText>
      <textField isStretchWithOverflow="true"><reportElement x="0" y="18" width="1600" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"    y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Group]]></text></staticText>
      <staticText><reportElement x="60"   y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Employee No]]></text></staticText>
      <staticText><reportElement x="120"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Surname]]></text></staticText>
      <staticText><reportElement x="240"  y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[First Name]]></text></staticText>
      <staticText><reportElement x="340"  y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Department]]></text></staticText>
      <staticText><reportElement x="400"  y="0" width="60"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Run No]]></text></staticText>
      <staticText><reportElement x="460"  y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Date]]></text></staticText>
      <staticText><reportElement x="550"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Code]]></text></staticText>
      <staticText><reportElement x="630"  y="0" width="300" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="930"  y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Hours]]></text></staticText>
      <staticText><reportElement x="1050" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Quantity]]></text></staticText>
      <staticText><reportElement x="1150" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Rate]]></text></staticText>
      <staticText><reportElement x="1250" y="0" width="100" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reference]]></text></staticText>
      <staticText><reportElement x="1350" y="0" width="250" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField isStretchWithOverflow="true"><reportElement x="0"    y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{paygroup}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="60"   y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{empNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="120"  y="0" width="120" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{surname}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="240"  y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{firstName}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="340"  y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{dept}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="400"  y="0" width="60"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{payrunNo}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="460"  y="0" width="90"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{payrunDate}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="550"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{payCode}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="630"  y="0" width="300" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codeDesc}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="930"  y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{hours}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="1050" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{qty}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="1150" y="0" width="100" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ratePerc}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="1250" y="0" width="100" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{ref}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="1350" y="0" width="250" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter><band height="0"/></pageFooter>

  <summary>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="1600" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement x="0" y="4" width="1350" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " line(s)   Grand Total:"]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00;(#,##0.00)"><reportElement x="1350" y="4" width="250" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
