<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="payroll-summary"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NO"   class="java.lang.Integer"/>
  <parameter name="YEAR_NO"      class="java.lang.Integer"/>
  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="YEAR_DESC"    class="java.lang.String"/>
  <parameter name="FROM_DATE"    class="java.sql.Date" isForPrompting="false"/>
  <parameter name="TO_DATE"      class="java.sql.Date" isForPrompting="false"/>

  <queryString>
    <![CDATA[
      SELECT r.payrun_no, r.payrun_date, r.paymt_date,
             COUNT(DISTINCT h.employee_no) AS no_of_employees_paid,
             COALESCE(SUM(CASE WHEN h.pay_type IN (1,2,3,4,5,6,7,8,11,12,13,14,15,16,17,18,23) THEN h.ext_amt ELSE 0 END),0) AS gross_pay,
             COALESCE(SUM(CASE WHEN h.pay_type=22 THEN h.ext_amt ELSE 0 END),0) AS tax_withheld,
             COALESCE(SUM(CASE WHEN h.pay_type=21 THEN h.ext_amt ELSE 0 END),0) AS super_amt,
             COALESCE(SUM(CASE WHEN h.pay_type IN (1,2,3,4,5,6,7,8,11,12,13,14,15,16,17,18,23) THEN h.ext_amt
                               WHEN h.pay_type IN (19,20,22) THEN -h.ext_amt ELSE 0 END),0) AS net_pay
      FROM parunhd r
      LEFT JOIN paehist h ON h.company_no=r.company_no AND h.payrun_no=r.payrun_no
      JOIN gldates d ON d.company_no=r.company_no AND d.yr_no=r.yr_no
      WHERE r.company_no = $P{COMPANY_NO}
        AND d.year_no    = $P{YEAR_NO}
        AND r.payrun_status IN ('P', 'F')
        AND ($P{FROM_DATE} IS NULL OR r.payrun_date >= $P{FROM_DATE})
        AND ($P{TO_DATE}   IS NULL OR r.payrun_date <= $P{TO_DATE})
      GROUP BY r.payrun_no, r.payrun_date, r.paymt_date
      ORDER BY r.payrun_date
    ]]>
  </queryString>

  <field name="payrun_no"            class="java.lang.Integer"/>
  <field name="payrun_date"          class="java.sql.Date"/>
  <field name="paymt_date"           class="java.sql.Date"/>
  <field name="no_of_employees_paid" class="java.lang.Long"/>
  <field name="gross_pay"            class="java.math.BigDecimal"/>
  <field name="tax_withheld"         class="java.math.BigDecimal"/>
  <field name="super_amt"            class="java.math.BigDecimal"/>
  <field name="net_pay"              class="java.math.BigDecimal"/>

  <variable name="TTL_GROSS" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{gross_pay}]]></variableExpression></variable>
  <variable name="TTL_TAX"   class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{tax_withheld}]]></variableExpression></variable>
  <variable name="TTL_SUPER" class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{super_amt}]]></variableExpression></variable>
  <variable name="TTL_NET"   class="java.math.BigDecimal" calculation="Sum"><variableExpression><![CDATA[$F{net_pay}]]></variableExpression></variable>

  <title>
    <band height="50">
      <staticText><reportElement x="0" y="0" width="782" height="20"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Payroll Summary]]></text></staticText>
      <textField isStretchWithOverflow="true"><reportElement x="0" y="22" width="500" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{YEAR_DESC}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="50"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Run No]]></text></staticText>
      <staticText><reportElement x="58"  y="4" width="80"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Date]]></text></staticText>
      <staticText><reportElement x="142" y="4" width="82"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Payment Date]]></text></staticText>
      <staticText><reportElement x="228" y="4" width="58"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Employees]]></text></staticText>
      <staticText><reportElement x="290" y="4" width="120" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Gross Pay]]></text></staticText>
      <staticText><reportElement x="414" y="4" width="110" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Tax Withheld]]></text></staticText>
      <staticText><reportElement x="528" y="4" width="110" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Superannuation]]></text></staticText>
      <staticText><reportElement x="642" y="4" width="136" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Net Pay]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="16">
      <textField isStretchWithOverflow="true"><reportElement x="4"   y="2" width="50"  height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{payrun_no}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="58"  y="2" width="80"  height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{payrun_date}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="142" y="2" width="82"  height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$F{paymt_date}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="228" y="2" width="58"  height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{no_of_employees_paid}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="290" y="2" width="120" height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{gross_pay}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="414" y="2" width="110" height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{tax_withheld}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="528" y="2" width="110" height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{super_amt}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="642" y="2" width="136" height="12"/><textElement textAlignment="Right"><font size="9"/></textElement><textFieldExpression><![CDATA[$F{net_pay}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField isStretchWithOverflow="true" pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true"><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="24">
      <rectangle><reportElement x="0" y="0" width="782" height="24" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4" y="5" width="282" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[YEAR TOTALS]]></text></staticText>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="290" y="5" width="120" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TTL_GROSS}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="414" y="5" width="110" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TTL_TAX}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="528" y="5" width="110" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TTL_SUPER}]]></textFieldExpression></textField>
      <textField isStretchWithOverflow="true" pattern="#,##0.00"><reportElement x="642" y="5" width="136" height="14" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$V{TTL_NET}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
