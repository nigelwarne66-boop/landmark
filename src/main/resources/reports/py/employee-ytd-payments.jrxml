<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="employee-ytd-payments"
              pageWidth="842" pageHeight="595" orientation="Landscape"
              columnWidth="782" leftMargin="30" rightMargin="30"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <!-- rowKind: "header"=employee name bar, "detail"=pay code line, "total"=employee subtotal -->
  <style name="rowLabel" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["detail".equals($F{rowKind})]]></conditionExpression>
      <style mode="Transparent" forecolor="#000000"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>
  <style name="rowNum" isBlankWhenNull="true">
    <conditionalStyle>
      <conditionExpression><![CDATA["detail".equals($F{rowKind})]]></conditionExpression>
      <style mode="Transparent" forecolor="#000000"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["header".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#506680" forecolor="#506680"/>
    </conditionalStyle>
    <conditionalStyle>
      <conditionExpression><![CDATA["total".equals($F{rowKind})]]></conditionExpression>
      <style mode="Opaque" backcolor="#1e2d45" forecolor="#ffffff" isBold="true"/>
    </conditionalStyle>
  </style>

  <parameter name="COMPANY_NAME" class="java.lang.String" isForPrompting="false"/>
  <parameter name="YEAR_DESC"    class="java.lang.String" isForPrompting="false"/>
  <parameter name="ACCT_RANGE"   class="java.lang.String" isForPrompting="false"/>
  <parameter name="GRAND_TOTAL"  class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="rowKind"   class="java.lang.String"/>
  <field name="empNo"     class="java.lang.Integer"/>
  <field name="surname"   class="java.lang.String"/>
  <field name="firstName" class="java.lang.String"/>
  <field name="paygroup"  class="java.lang.String"/>
  <field name="dept"      class="java.lang.String"/>
  <field name="payType"   class="java.lang.Integer"/>
  <field name="payCode"   class="java.lang.String"/>
  <field name="codeDesc"  class="java.lang.String"/>
  <field name="hours"     class="java.math.BigDecimal"/>
  <field name="amount"    class="java.math.BigDecimal"/>

  <title>
    <band height="52">
      <staticText><reportElement x="0" y="0" width="500" height="18"/><textElement><font size="13" isBold="true"/></textElement><text><![CDATA[Employee YTD Payments]]></text></staticText>
      <textField><reportElement x="0" y="22" width="560" height="14"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "  —  " + $P{YEAR_DESC}]]></textFieldExpression></textField>
      <textField><reportElement x="0" y="38" width="560" height="12"/><textElement><font size="8" isItalic="true"/></textElement><textFieldExpression><![CDATA[$P{ACCT_RANGE}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy HH:mm"><reportElement x="600" y="22" width="182" height="12"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="20">
      <rectangle><reportElement x="0" y="0" width="782" height="20" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <staticText><reportElement x="4"   y="4" width="76"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Pay Code]]></text></staticText>
      <staticText><reportElement x="84"  y="4" width="360" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="8" isBold="true"/></textElement><text><![CDATA[Description]]></text></staticText>
      <staticText><reportElement x="448" y="4" width="78"  height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Hours]]></text></staticText>
      <staticText><reportElement x="530" y="4" width="140" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="8" isBold="true"/></textElement><text><![CDATA[Amount]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <rectangle><reportElement x="0" y="0" width="782" height="14" backcolor="#506680" forecolor="#506680"><printWhenExpression><![CDATA["header".equals($F{rowKind})]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <rectangle><reportElement x="0" y="0" width="782" height="14" backcolor="#1e2d45" forecolor="#1e2d45"><printWhenExpression><![CDATA["total".equals($F{rowKind})]]></printWhenExpression></reportElement><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField isStretchWithOverflow="true"><reportElement style="rowLabel" x="4" y="2" width="440" height="10"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{codeDesc}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00"><reportElement style="rowNum" x="448" y="2" width="78" height="10"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{hours}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement style="rowNum" x="530" y="2" width="140" height="10"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{amount}]]></textFieldExpression></textField>
    </band>
  </detail>

  <pageFooter>
    <band height="16">
      <textField pattern="dd/MM/yyyy"><reportElement x="0" y="2" width="100" height="12"/><textElement><font size="7"/></textElement><textFieldExpression><![CDATA[new java.util.Date()]]></textFieldExpression></textField>
      <textField><reportElement x="660" y="2" width="122" height="12"/><textElement textAlignment="Right"><font size="7"/></textElement><textFieldExpression><![CDATA["Page " + $V{PAGE_NUMBER}]]></textFieldExpression></textField>
    </band>
  </pageFooter>

  <summary>
    <band height="28">
      <rectangle><reportElement x="0" y="0" width="782" height="28" backcolor="#1e2d45"/><graphicElement><pen lineWidth="0"/></graphicElement></rectangle>
      <textField><reportElement x="4" y="8" width="300" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " line(s)"]]></textFieldExpression></textField>
      <staticText><reportElement x="390" y="8" width="136" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><text><![CDATA[Grand Total:]]></text></staticText>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="530" y="8" width="140" height="12" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{GRAND_TOTAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
