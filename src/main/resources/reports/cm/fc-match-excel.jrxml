<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
              http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="fc-match-excel"
              pageWidth="1200" pageHeight="595" orientation="Landscape"
              columnWidth="1160" leftMargin="20" rightMargin="20"
              topMargin="20" bottomMargin="20"
              whenNoDataType="AllSectionsNoDetail">

  <property name="net.sf.jasperreports.export.xls.exclude.origin.keep.first.band.1" value="columnHeader"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.1" value="pageFooter"/>
  <property name="net.sf.jasperreports.export.xls.exclude.origin.band.2" value="title"/>

  <style name="base" isDefault="true" isBlankWhenNull="true"/>

  <parameter name="COMPANY_NAME" class="java.lang.String"/>
  <parameter name="BANK_DESC"    class="java.lang.String"     isForPrompting="false"/>
  <parameter name="DATE_RANGE"   class="java.lang.String"     isForPrompting="false"/>
  <parameter name="SUM_LOCAL"    class="java.math.BigDecimal" isForPrompting="false"/>
  <parameter name="ROW_COUNT"    class="java.lang.Integer"    isForPrompting="false"/>

  <field name="docDate"      class="java.sql.Date"/>
  <field name="docType"      class="java.lang.String"/>
  <field name="docNo"        class="java.lang.Integer"/>
  <field name="localAmt"     class="java.math.BigDecimal"/>
  <field name="origLocalAmt" class="java.math.BigDecimal"/>
  <field name="parentAmt"    class="java.math.BigDecimal"/>
  <field name="exchangeRate" class="java.math.BigDecimal"/>
  <field name="lastRate"     class="java.math.BigDecimal"/>
  <field name="revalDate"    class="java.sql.Date"/>
  <field name="status"       class="java.lang.String"/>

  <title>
    <band height="32">
      <staticText><reportElement x="0" y="0" width="800" height="18"/><textElement><font size="12" isBold="true"/></textElement><text><![CDATA[Cashbook Foreign Currency Match]]></text></staticText>
      <textField><reportElement x="0" y="18" width="1160" height="12"/><textElement><font size="9"/></textElement><textFieldExpression><![CDATA[$P{COMPANY_NAME} + "   —   " + $P{BANK_DESC} + "   —   " + $P{DATE_RANGE}]]></textFieldExpression></textField>
    </band>
  </title>

  <columnHeader>
    <band height="18">
      <staticText><reportElement x="0"   y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Date]]></text></staticText>
      <staticText><reportElement x="70"  y="0" width="80"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Type]]></text></staticText>
      <staticText><reportElement x="150" y="0" width="70"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Document No]]></text></staticText>
      <staticText><reportElement x="220" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Local Amount]]></text></staticText>
      <staticText><reportElement x="340" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Orig Local Amt]]></text></staticText>
      <staticText><reportElement x="460" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Parent Amount]]></text></staticText>
      <staticText><reportElement x="580" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Exchange Rate]]></text></staticText>
      <staticText><reportElement x="700" y="0" width="120" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Last Rate]]></text></staticText>
      <staticText><reportElement x="820" y="0" width="90"  height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Reval Date]]></text></staticText>
      <staticText><reportElement x="910" y="0" width="250" height="18" forecolor="#ffffff" mode="Opaque" backcolor="#1e2d45"/><textElement verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Status]]></text></staticText>
    </band>
  </columnHeader>

  <detail>
    <band height="14">
      <textField pattern="dd/MM/yyyy"><reportElement x="0"   y="0" width="70"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docDate}]]></textFieldExpression></textField>
      <textField><reportElement x="70"  y="0" width="80"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docType}]]></textFieldExpression></textField>
      <textField pattern="#0"><reportElement x="150" y="0" width="70"  height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{docNo}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="220" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{localAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="340" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{origLocalAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="460" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{parentAmt}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="580" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{exchangeRate}]]></textFieldExpression></textField>
      <textField pattern="#,##0.0000"><reportElement x="700" y="0" width="120" height="14"/><textElement textAlignment="Right"><font size="8"/></textElement><textFieldExpression><![CDATA[$F{lastRate}]]></textFieldExpression></textField>
      <textField pattern="dd/MM/yyyy"><reportElement x="820" y="0" width="90"  height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{revalDate}]]></textFieldExpression></textField>
      <textField><reportElement x="910" y="0" width="250" height="14"/><textElement><font size="8"/></textElement><textFieldExpression><![CDATA[$F{status}]]></textFieldExpression></textField>
    </band>
  </detail>

  <summary>
    <band height="20">
      <textField><reportElement x="0" y="3" width="440" height="14"/><textElement><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[($P{ROW_COUNT}==null?0:$P{ROW_COUNT}) + " FC transaction(s)"]]></textFieldExpression></textField>
      <textField pattern="#,##0.00;(#,##0.00)"><reportElement x="220" y="3" width="120" height="14"/><textElement textAlignment="Right"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{SUM_LOCAL}]]></textFieldExpression></textField>
    </band>
  </summary>

</jasperReport>
