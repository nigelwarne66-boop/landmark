<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.0</version>
    <relativePath/>
  </parent>

  <groupId>com.landmarksoftware</groupId>
  <artifactId>landmark-desktop</artifactId>
  <version>1.0.0-SNAPSHOT</version>
  <name>Landmark</name>

  <properties>
    <java.version>21</java.version>
    <javafx.version>21.0.11</javafx.version>
    <poi.version>5.2.5</poi.version>
    <!-- Override Spring Boot's managed 3.19.8 — local install matches Pro edition version -->
    <jooq.version>3.21.4</jooq.version>
  </properties>

  <dependencies>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
    </dependency>

    <!-- BCrypt password hashing — used by PasswordService for user auth migration -->
    <dependency>
      <groupId>org.springframework.security</groupId>
      <artifactId>spring-security-crypto</artifactId>
    </dependency>

    <!-- JavaFX runtime — desktop UI -->
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-controls</artifactId>
      <version>${javafx.version}</version>
    </dependency>
    <dependency>
      <groupId>org.openjfx</groupId>
      <artifactId>javafx-fxml</artifactId>
      <version>${javafx.version}</version>
    </dependency>

    <!-- Ikonli — icon font support for JavaFX.
         Desktop uses ikonli-feather-pack (Feather icons, fth-* prefix).
         Tabler icon names in DESIGN_SYSTEM.md are the canonical set for the web
         app; Feather equivalents are used here until ikonli-tabler-pack is
         available in Maven Central. -->
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-javafx</artifactId>
      <version>12.3.1</version>
    </dependency>
    <dependency>
      <groupId>org.kordamp.ikonli</groupId>
      <artifactId>ikonli-feather-pack</artifactId>
      <version>12.3.1</version>
    </dependency>

    <!-- PDF export (FA reports) — uses 2.x API (PDType1Font.HELVETICA as static field) -->
    <dependency>
      <groupId>org.apache.pdfbox</groupId>
      <artifactId>pdfbox</artifactId>
      <version>2.0.32</version>
    </dependency>

    <!-- Excel export (FA reports) — Apache POI -->
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi</artifactId>
      <version>${poi.version}</version>
    </dependency>
    <dependency>
      <groupId>org.apache.poi</groupId>
      <artifactId>poi-ooxml</artifactId>
      <version>${poi.version}</version>
    </dependency>

    <!-- JasperReports — server-side report engine driving the Reports Hub.
         .jrxml files in src/main/resources/reports/, compiled on first use. -->
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports</artifactId>
      <version>6.21.0</version>
      <exclusions>
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>net.sf.jasperreports</groupId>
      <artifactId>jasperreports-fonts</artifactId>
      <version>6.21.0</version>
    </dependency>

    <!-- MySQL JDBC driver -->
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- jOOQ — type-safe SQL DSL with multi-dialect support.
         Open-source edition covers MySQL + MariaDB.
         Upgrade groupId to org.jooq.pro for SQL Server (commercial licence). -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jooq</artifactId>
    </dependency>

  </dependencies>

  <build>
    <plugins>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <source>21</source>
          <target>21</target>
          <release>21</release>
        </configuration>
      </plugin>

      <!-- Run the JavaFX desktop app: mvn javafx:run -->
      <plugin>
        <groupId>org.openjfx</groupId>
        <artifactId>javafx-maven-plugin</artifactId>
        <version>0.0.8</version>
        <configuration>
          <mainClass>com.landmarksoftware.desktop.FixedAssetsApplication</mainClass>
          <options>
            <option>--add-opens</option>
            <option>javafx.graphics/com.sun.javafx.application=ALL-UNNAMED</option>
            <option>--add-opens</option>
            <option>java.base/java.lang=ALL-UNNAMED</option>
          </options>
        </configuration>
      </plugin>

      <!-- src/main/generated holds jOOQ-generated table/column DSL classes.
           Always registered as a source root so normal builds compile without
           needing a live DB. Re-generate with: mvn generate-sources -Pjooq-codegen -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>add-jooq-sources</id>
            <phase>generate-sources</phase>
            <goals><goal>add-source</goal></goals>
            <configuration>
              <sources>
                <source>src/main/generated</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- ProGuard obfuscation — runs in the package phase after maven-jar-plugin.
           Rules live in src/main/proguard/rules.pro.
           Output: target/${project.build.finalName}-obf.jar
           Mapping: target/proguard_map.txt (keep this to decode stack traces). -->
      <plugin>
        <groupId>com.github.wvengen</groupId>
        <artifactId>proguard-maven-plugin</artifactId>
        <version>2.6.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>proguard</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <proguardVersion>7.7.0</proguardVersion>
          <obfuscate>true</obfuscate>
          <injar>${project.build.finalName}.jar</injar>
          <outjar>${project.build.finalName}-obf.jar</outjar>
          <!-- Only process our code; library deps stay untouched.
               inFilter restricts WHAT inside the input jar gets obfuscated.
               includeDependency=true puts Maven deps on ProGuard's library
               path so it can resolve Spring/JavaFX class references. -->
          <inFilter>com/landmarksoftware/**</inFilter>
          <includeDependency>true</includeDependency>
          <proguardInclude>${project.basedir}/src/main/proguard/rules.pro</proguardInclude>
          <!-- JDK class library reference. ProGuard 7.7.0 caps at class file
               version 68 (JDK 24); JDK 25 jmods are version 69, so we point
               at JRE 1.8 rt.jar instead. It supplies all standard java.*
               classes our code references; newer-API references will surface
               as missing-class warnings, suppressed by -dontwarn in rules.pro. -->
          <libs>
            <lib>C:\Program Files\Java\jre1.8.0_421\lib\rt.jar</lib>
          </libs>
        </configuration>
        <dependencies>
          <dependency>
            <groupId>com.guardsquare</groupId>
            <artifactId>proguard-base</artifactId>
            <version>7.7.0</version>
          </dependency>
          <!-- Pin proguard-core to match proguard-base 7.7.0 — the plugin's
               transitive 9.0.1 is binary-incompatible with newer base versions. -->
          <dependency>
            <groupId>com.guardsquare</groupId>
            <artifactId>proguard-core</artifactId>
            <version>9.1.10</version>
          </dependency>
        </dependencies>
      </plugin>

    </plugins>
  </build>

  <profiles>
    <!-- jOOQ code generation:  mvn generate-sources -Pjooq-codegen
         Connects to the local MySQL dev DB and regenerates the type-safe
         table/column DSL classes into src/main/generated/.
         Re-run whenever the lmextract schema changes.
         To upgrade to SQL Server (commercial): change the jdbc block to point
         at the SQL Server DB, change database name to
         org.jooq.meta.sqlserver.SQLServerDatabase, and change groupId of
         spring-boot-starter-jooq dependency to org.jooq.pro edition. -->
    <profile>
      <id>jooq-codegen</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jooq</groupId>
            <artifactId>jooq-codegen-maven</artifactId>
            <version>${jooq.version}</version>
            <executions>
              <execution>
                <goals><goal>generate</goal></goals>
              </execution>
            </executions>
            <configuration>
              <jdbc>
                <driver>com.mysql.cj.jdbc.Driver</driver>
                <url>jdbc:mysql://localhost:3306/lmextract?useSSL=false&amp;allowPublicKeyRetrieval=true&amp;serverTimezone=Australia/Perth</url>
                <user>root</user>
                <password>another</password>
              </jdbc>
              <generator>
                <database>
                  <name>org.jooq.meta.mysql.MySQLDatabase</name>
                  <inputSchema>lmextract</inputSchema>
                  <includes>.*</includes>
                </database>
                <generate>
                  <records>true</records>
                  <pojos>false</pojos>
                  <daos>false</daos>
                </generate>
                <target>
                  <packageName>com.landmarksoftware.db</packageName>
                  <directory>src/main/generated</directory>
                </target>
              </generator>
            </configuration>
            <dependencies>
              <dependency>
                <groupId>com.mysql</groupId>
                <artifactId>mysql-connector-j</artifactId>
                <version>8.3.0</version>
              </dependency>
            </dependencies>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Distribution build:  mvn package -Preporting,dist
         Requires Liberica Full JDK 21 as JAVA_HOME (bundles JavaFX jmods).
         Produces target/installer/Landmark Reporting-1.0.0.exe (needs WiX 3.x).
         For a folder-only output (no WiX needed), change type to app-image. -->
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <version>3.3.0</version>
            <executions>

              <!-- Step 1: jlink — create minimal bundled JRE with JavaFX -->
              <execution>
                <id>jlink</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jlink</executable>
                  <arguments>
                    <argument>--module-path</argument>
                    <argument>${java.home}/jmods</argument>
                    <argument>--add-modules</argument>
                    <argument>java.base,java.sql,java.naming,java.management,java.logging,java.desktop,java.net.http,java.xml,java.security.jgss,java.instrument,javafx.controls,javafx.fxml,javafx.graphics,javafx.base</argument>
                    <argument>--output</argument>
                    <argument>${project.build.directory}/runtime</argument>
                    <argument>--compress=2</argument>
                    <argument>--no-header-files</argument>
                    <argument>--no-man-pages</argument>
                    <argument>--strip-debug</argument>
                  </arguments>
                </configuration>
              </execution>

              <!-- Step 2: jpackage — wrap JAR + runtime into Windows installer -->
              <execution>
                <id>jpackage</id>
                <phase>package</phase>
                <goals><goal>exec</goal></goals>
                <configuration>
                  <executable>jpackage</executable>
                  <arguments>
                    <argument>--name</argument>
                    <argument>Landmark Reporting</argument>
                    <argument>--app-version</argument>
                    <argument>1.0.0</argument>
                    <argument>--input</argument>
                    <argument>${project.build.directory}/dist-input</argument>
                    <argument>--main-jar</argument>
                    <argument>${project.build.finalName}.jar</argument>
                    <argument>--main-class</argument>
                    <argument>com.landmarksoftware.desktop.ReportingApplication</argument>
                    <argument>--runtime-image</argument>
                    <argument>${project.build.directory}/runtime</argument>
                    <argument>--java-options</argument>
                    <argument>--add-opens=javafx.graphics/com.sun.javafx.application=ALL-UNNAMED</argument>
                    <argument>--java-options</argument>
                    <argument>--add-opens=java.base/java.lang=ALL-UNNAMED</argument>
                    <argument>--type</argument>
                    <argument>exe</argument>
                    <argument>--icon</argument>
                    <argument>${project.basedir}/deploy/landmark.ico</argument>
                    <argument>--win-dir-chooser</argument>
                    <argument>--win-menu</argument>
                    <argument>--win-shortcut</argument>
                    <argument>--dest</argument>
                    <argument>${project.build.directory}/installer</argument>
                  </arguments>
                </configuration>
              </execution>

            </executions>
          </plugin>

          <!-- Copy fat JAR + per-client config template into dist-input staging dir -->
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>copy-dist-inputs</id>
                <phase>prepare-package</phase>
                <goals><goal>copy-resources</goal></goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/dist-input</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/deploy</directory>
                      <filtering>false</filtering>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- ICO generator:  mvn javafx:run -Pgenerate-ico
         Renders the Landmark pin-mark at 16/32/48/256 px and writes
         deploy/landmark.ico for use by jpackage (icon arg) in the dist profile.
         Run once; commit the resulting ICO file. -->
    <profile>
      <id>generate-ico</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <configuration>
              <mainClass>com.landmarksoftware.util.GenerateLandmarkIco</mainClass>
              <options>
                <option>--add-opens</option>
                <option>javafx.graphics/com.sun.javafx.application=ALL-UNNAMED</option>
                <option>--add-opens</option>
                <option>java.base/java.lang=ALL-UNNAMED</option>
                <option>--add-modules</option>
                <option>java.desktop</option>
              </options>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!-- Reporting-only build:  mvn javafx:run -Preporting
         Boots the same Spring context + login, then branches on AppMode
         to load /fxml/reports-hub.fxml instead of MainMenuController. -->
    <profile>
      <id>reporting</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-maven-plugin</artifactId>
            <configuration>
              <mainClass>com.landmarksoftware.desktop.ReportingApplication</mainClass>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

</project>
